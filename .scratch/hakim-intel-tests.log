        assert_eq: got { "archie_craft_chat": { "id": "archie_craft_chat", "cards": [{ "type": "narration", "label": "Later - Spitalfields Market", "speaker": <null>, "text": "Archie is eating a falafel wrap and looking at his phone. He waves you over without looking up, which is either comfortable familiarity or mild rudeness. Probably both." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Alright. How\'d it go with James, then?\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"He taught me how to make the pearls. Basic stuff, but — it worked.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "Archie stops chewing. He looks at you with an expression you haven\'t seen on him before: genuine surprise." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"He actually showed you? How to craft?\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"Yeah. Why?\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Because James doesn\'t show people things. James does things, judges people for not knowing how to do them, and considers that a complete interaction. Either he was absolutely desperate, or...\" He tilts his head. \"He saw something worth the bother.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Don\'t let it go to your head. You\'re at the bottom of a very long ladder. James has been at this for thirty years and he still considers himself underappreciated, which should tell you something about the ceiling.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"That said — keep practising. Seriously. Being able to craft your own means you\'re not at the mercy of James\'s prices, which frankly are a war crime. And it\'s a marketable skill.\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"Marketable how?\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Same way the ore is. There\'s buyers for finished product too — people who want pearls and don\'t have a James. I can start lining them up. Anything you make that you don\'t need, bring it to me. We split it down the middle, same as the calc.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "He finishes his wrap and bins the wrapper from four metres away. It goes in first time. He doesn\'t acknowledge this at all." }], "on_complete": [{ "op": "set_flag", "flag": "archieCraftChatSeen", "value": true }, { "op": "set_flag", "flag": "canSellConsumables", "value": true }, { "op": "set_stage", "value": "free" }, { "op": "relation", "contact": "archie", "value": 5 }, { "op": "add_ore", "type": "time", "qty": 20 }, { "op": "set_flag", "flag": "homeRaidEventPending", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "archie_cultivation": { "id": "archie_cultivation", "pin": { "district": "whitechapel", "showWhenFlagsTrue": ["archiePartnerSeen"], "showWhenFlagsFalse": ["cultivationTutorialSeen"], "contact": "archie", "phoneLabel": "Go and see Archie about the vein" }, "cards": [{ "type": "narration", "label": "Whitechapel — behind the old brewery", "speaker": <null>, "text": "The vein is exactly where the pin said: a hairline crack in old brick, humming faintly at a frequency you\'d ignore if you didn\'t already know what you were listening for. Archie\'s waiting with his hands in his pockets, doing an impression of a man who has never once stood around looking impatient." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Right. It\'s yours now, so you should know how it actually works, not just what the app tells you.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"See that number on it? Growth. Runs nought to a hundred, dead centre at fifty. Leave it be and it drifts — climbs if it was already climbing, sinks if it was already sinking. Doesn\'t just sit there, whatever you do.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Cultivate pushes it up. Put a session in — might take, might not, that part\'s down to your own skill. Land it low and it jumps a fair way; land it near the top and you\'re barely nudging it. Miss, and you\'ve lost nothing but the time.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Prune\'s how the calc actually comes out, and it only pays once you\'re past fifty. Light prune takes a bit, leaves the rest growing. Hard prune takes more, sets it right back — more calc for your trouble, mind.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Run one all the way down and leave it there, and it won\'t wait patient for you — spent long enough, it just collapses and disappears on you. The patch stays, mind, ready to seed again — it\'s the vein you lose.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"So don\'t get greedy on something you can\'t afford to lose. Go on, then — put a session in. I\'ll watch, so you don\'t feel like you\'re talking to brick.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You work the vein the way he showed you. It takes, first go — beginner\'s luck, or possibly just Archie standing close enough to make failure socially awkward. The growth number ticks up. Somewhere under Whitechapel, something that used to belong to someone else settles into belonging to you." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"There. Not complicated. Keep at it, and don\'t tell anyone else where it is.\"" }], "on_complete": [{ "op": "tutorial_cultivate" }, { "op": "relation", "contact": "archie", "value": 2 }, { "op": "set_flag", "flag": "cultivationTutorialSeen", "value": true }, { "op": "queue_pending_message", "contact": "archie", "kind": "col_a1_intro", "text": "Come by the lock-up. Got someone you need to meet. Don\'t make a thing of it." }, { "op": "set_screen", "screen": "map" }] }, "archie_motion": { "id": "archie_motion", "cards": [{ "type": "narration", "label": "A message from Archie", "speaker": <null>, "text": "You\'ve been moving product. It\'s working. Archie\'s text simply says: \"good output. call me.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"So the consumables are going well. Got a buyer asking for more pearls and asking if there\'s anything else on offer. Which made me think — can you make anything else?\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"Not yet. James only taught me the pearls.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Yeah. Right. See, James knows how to make about forty different things and he\'s sitting on all of it. Which is his prerogative, obviously. But I\'m thinking — have you got any sort of relationship with him yet? Because it might be worth asking.\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"Asking him to teach me more?\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Gently. James doesn\'t respond well to being asked for things directly. Try framing it as being useful to him. Which, actually, you could be — if he\'s got orders he can\'t fill, you could take the overflow. Might be the angle.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Worth a try anyway. He\'s the only craftsman I know who isn\'t either retired or in prison, so options are limited.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "He hangs up before you can ask anything else. You look up James\'s address in your phone." }], "on_complete": [{ "op": "set_flag", "flag": "archieMotionEventSeen", "value": true }, { "op": "queue_pending_message", "contact": "james", "kind": "james_motion", "text": "Overflow work, if you\'re capable of it. Come by." }, { "op": "set_screen", "screen": "contacts" }] }, "battersea_hum": { "id": "battersea_hum", "cards": [{ "type": "narration", "label": "Battersea", "speaker": <null>, "text": "The old power station hasn\'t generated anything since before your parents were your age, and it still hums, very faintly, like a tooth that\'s been pulled but hasn\'t told the nerve yet." }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You put your hand flat against the brick for exactly as long as feels socially acceptable to touch a decommissioned building, and come away with a faint charge of physics-type static in your palm." }], "on_complete": [{ "op": "add_ore", "type": "physics", "qty": 1 }, { "op": "set_screen", "screen": "map" }], "deck": { "district": "battersea", "weight": 1, "excludeIfFlag": <null>, "barometerState": <null> } }, "busker_greenwich": { "id": "busker_greenwich", "cards": [{ "type": "narration", "label": "Greenwich Market", "speaker": <null>, "text": "By the market, a busker inflates himself explaining the finer points of the zero meridian to a strictly disinterested crowd. He clocks you before you clock him." }, { "type": "speaker", "label": <null>, "speaker": "Busker", "text": "\"You look like someone who deals in the good stuff. I know things - like where some small timers may have stashed some calc. Worth twenty quid to a man who knows how to spend it.\"" }, { "type": "choice", "label": <null>, "speaker": <null>, "text": "He\'s either got something, or he\'s very good at pretending.", "choices": [{ "label": "Give him £20", "effects": [{ "op": "add", "path": "player.cash", "value": -20 }, { "op": "add_ore", "type": "time", "qty": 1 }, { "op": "set_flag", "flag": "greenwichTipOff", "value": true }], "result_text": "He pockets the note and taps the side of his nose. \"Bus stop outside the McDonalds. Paving stone next to the bench is loose; lift it up and you\'ll get a nice surprise\". Funnily, he\'s telling the truth; there\'s a small stash of calc. Or more accurately, there WAS a small stash of calc." }, { "label": "Keep walking", "effects": [], "result_text": "You keep walking. He shouts something about the Meridian after you. You don\'t catch it, and don\'t ask him to repeat it." }] }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "Whether or not he was lying, Greenwich feels marginally more interesting than it did five minutes ago." }], "on_complete": [{ "op": "set_screen", "screen": "map" }], "deck": { "district": "greenwich", "weight": 1, "excludeIfFlag": <null>, "barometerState": <null> } }, "buyer": { "id": "buyer", "cards": [{ "type": "narration", "label": "The next morning", "speaker": <null>, "text": "Archie texts an address in Shoreditch and the word \"tonight\". You arrive to find him outside a craft beer bar, looking mildly disgusted by its existence." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Right. Same calc from the other night — I held onto it. Buyer\'s inside. Name\'s Marcus, finance, collects emotion-type for what he calls \'recreational use\'. Don\'t ask. Just be normal. Or close to it.\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"This is the same stuff. From when they tried to rob us.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Correct. Which is why having two of us is better than one. You\'re essentially a deterrent. Like a scarecrow. No offence.\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"Some offence.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Noted.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "Marcus is exactly what you expected: fleece, Patagonia, very clean trainers. He examines the calc with the careful enthusiasm of someone who has recently read about it online. He pays promptly, which is nice." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"See? Smooth as you like. Most of them are like Marcus. Professional, prompt, no Stanley knife. That\'s the market we\'re targeting.\"" }, { "type": "resolution", "label": "Walking back — Shoreditch High Street", "speaker": <null>, "text": "Archie splits the cash on the pavement outside a Pret. The city moves around you, completely indifferent to any of this." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"So. I\'ve got a contact who knows a lot more about this than I do. Bloke called James — craftsman, Bermondsey. Takes raw calc and makes things out of it. Like the pearls. I\'ve been meaning to introduce you.\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"Sure.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"I\'ll set it up. Give me a bell tomorrow.\"" }], "on_complete": [{ "op": "add", "path": "player.cash", "value": 40 }, { "op": "set_flag", "flag": "buyerEventSeen", "value": true }, { "op": "set_stage", "value": "sms_archie" }, { "op": "push_message", "contact": "archie", "from": "player", "text": "You mentioned a bloke called James. When can we sort that?" }, { "op": "push_message", "contact": "archie", "text": "Already arranged. Tomorrow — SE1 4YA, storage unit behind the Costcutter. Midday." }, { "op": "queue_pending_message", "contact": "archie", "kind": "james_meeting", "text": "Fair warning: James is the best craftsman I know and also the worst person I know. Don\'t take it personally. He\'s like that with everyone." }, { "op": "set_screen", "screen": "phone" }] }, "camden_shakedown": { "id": "camden_shakedown", "cards": [{ "type": "narration", "label": "Camden", "speaker": <null>, "text": "Two lads corner you near the lock, doing their best impression of menace between a falafel stall and a man selling knock-off headphones. It\'s not entirely unconvincing." }, { "type": "speaker", "label": <null>, "speaker": "One of Them", "text": "\"Toll for using this bit of pavement. Fifty quid, and we all have a nice afternoon.\"" }, { "type": "choice", "label": <null>, "speaker": <null>, "text": "The third one just stands there, which is somehow worse.", "choices": [{ "label": "Pay £50", "effects": [{ "op": "add", "path": "player.cash", "value": -50 }], "result_text": "You pay. They seem almost disappointed not to have to do anything. You walk on with your dignity roughly 90% intact." }, { "label": "Refuse", "effects": [{ "op": "chance", "p": 0.4, "on_success": [{ "op": "start_street_mugging" }], "on_fail": [] }], "result_text": "You refuse. For a second, nobody moves - whatever happens next happens fast." }] }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "Camden closes back over you like nothing happened. Somewhere, a man is still selling headphones that don\'t work." }], "on_complete": [{ "op": "set_screen", "screen": "map" }], "deck": { "district": "camden", "weight": 1, "excludeIfFlag": <null>, "barometerState": <null> } }, "city_suit": { "id": "city_suit", "cards": [{ "type": "narration", "label": "The City", "speaker": <null>, "text": "A man in a suit that costs more than your flat buys you a coffee you didn\'t order, in a café you\'d never choose. He introduces himself as \"a friend of a friend\", which in the City means nobody vouches for him." }, { "type": "speaker", "label": <null>, "speaker": "The Suit", "text": "\"I collect fate-type. Recreationally, you understand. Two hundred up front, I match it eightfold if the numbers land. If they don\'t — well. Markets.\"" }, { "type": "choice", "label": <null>, "speaker": <null>, "text": "He\'s already got his card reader out.", "choices": [{ "label": "Trade (£200)", "effects": [{ "op": "add", "path": "player.cash", "value": -200 }, { "op": "chance", "p": 0.5, "on_success": [{ "op": "add_ore", "type": "fate", "qty": 8 }], "on_fail": [] }], "result_text": "He taps his card against yours and doesn\'t blink. The transaction completes with the finality of all City transactions — you\'ll know how it went when you check your ore." }, { "label": "Pass", "effects": [], "result_text": "\"Suit yourself,\" he says, and you both know exactly which word he chose." }] }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "He\'s gone by the time you check your phone. Some men are only ever passing through." }], "on_complete": [{ "op": "set_screen", "screen": "map" }], "deck": { "district": "city", "weight": 1, "excludeIfFlag": <null>, "barometerState": <null> } }, "col_a1_archie_pry": { "id": "col_a1_archie_pry", "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "You mention Des. Archie\'s face does the thing it does, which is nothing at all, quite deliberately." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"He\'s good at ground. Best I know. Leave it there.\"" }, { "type": "choice", "label": <null>, "speaker": <null>, "text": "He very obviously wants to leave it there.", "choices": [{ "label": "Leave it", "effects": [], "result_text": "You leave it. He looks briefly grateful and then annoyed with himself for looking grateful." }, { "label": "Push", "effects": [{ "op": "set_flag", "flag": "colA1AskedAboutDebt", "value": true }, { "op": "start_event", "event": "col_a1_archie_pry_debt" }], "result_text": "" }] }], "on_complete": [{ "op": "set_screen", "screen": "contacts" }] }, "col_a1_archie_pry_debt": { "id": "col_a1_archie_pry_debt", "cards": [{ "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Four hundred and twenty quid. Fourteenth of March, 2019. I know because I wrote it in the book, because that\'s what you do.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"He\'s had six years and about nine conversations to say \'here\'s your money\' and instead I get - \" he does an impression that is unkind and quite accurate - \" \'we\'re all right, aren\'t we.\'\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "It is four hundred and twenty pounds. Archie has, in the time you\'ve known him, given away a vein." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Also, he\'s Crystal Palace. Obviously untrustworthy.\" He says it in the specific tone of a man producing a joke because the real answer has run out." }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "So that\'s what that is. A tenner\'s worth of grievance with six years of compound interest on it. You stop wondering about it, which is exactly what you were supposed to do." }], "on_complete": [{ "op": "set_screen", "screen": "contacts" }] }, "col_a1_closer": { "id": "col_a1_closer", "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "All three of them are in the yard, which has never happened before and is not, apparently, an occasion. Nadia is sitting on an upturned crate. Des has his bag." }, { "type": "speaker", "label": <null>, "speaker": "Hakim", "text": "\"So there\'s a spot behind the flats on the other side of the estate. Been looking at it for about a year, wondering.\"" }, { "type": "speaker", "label": <null>, "speaker": "Hakim", "text": "\"It\'s life. Which is wrong for round here — round here is emotion, everyone knows that. But it\'s life, and it\'s good ground, and I don\'t know what to do with good ground.\"" }, { "type": "speaker", "label": <null>, "speaker": "Hakim", "text": "\"You\'re the one who\'s good at putting things in. So.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "Des has already got the jar out of his bag. He does not make a speech about it. He does not appear to have considered any other course of action." }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Forty units, life. Had it about a month waiting for somewhere to put it.\"" }, { "type": "choice", "label": <null>, "speaker": <null>, "text": "You start to say something about paying him back.", "choices": [{ "label": "Thank him", "effects": [], "result_text": "\"You\'re all right,\" he says, and means it, and the subject is closed." }, { "label": "Insist on paying", "effects": [], "result_text": "\"You can pay me back by doing this for somebody else in about a year.\" He hands you the jar. \"That\'s not me being nice, that\'s just how the accounting works round here.\"" }] }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "It takes first time. The three of them watch you do it and then go straight back to talking about somebody\'s boiler." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "Later, walking back, you ask Des how you\'d actually join. Whether there\'s someone to ask." }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"There\'s no list. Nobody keeps one.\" He seems mildly amused you\'d think there was. \"You\'ve been doing this with us for a month. You\'re either one of us or you\'re not, and that\'s not really my call.\"" }, { "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"He means yes.\"" }, { "type": "choice", "label": <null>, "speaker": <null>, "text": "Behind you, Whitechapel does what it does.", "choices": [{ "label": "I\'m in", "effects": [{ "op": "join_faction", "faction": "collective" }, { "op": "set_flag", "flag": "colA1Joined", "value": true }], "result_text": "\"Right,\" says Des, and that\'s the ceremony." }, { "label": "Not yet", "effects": [{ "op": "set_flag", "flag": "colA1DeferredJoin", "value": true }], "result_text": "\"Fair enough.\" He isn\'t offended. \"Offer doesn\'t expire. There\'s nothing to expire.\"" }] }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You have a life vein in Whitechapel that a newsagent found and a prospector paid for, and no document anywhere records that any of this happened." }], "on_complete": [{ "op": "scripted_seed", "district": "whitechapel", "tier": "rich", "oreType": "life" }, { "op": "set_flag", "flag": "colA1Stage", "value": "complete" }, { "op": "set_flag", "flag": "colA1Complete", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a1_deferred_join": { "id": "col_a1_deferred_join", "cards": [{ "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Right,\" he says, like you\'ve asked him what time it is. \"You\'re in. Don\'t need a form for it.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "That\'s it. That\'s the whole thing. Nobody hands you anything to prove it, and you walk out fractionally more a part of something than you were an hour ago." }], "on_complete": [{ "op": "join_faction", "faction": "collective" }, { "op": "set_flag", "flag": "colA1Joined", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a1_des_report": { "id": "col_a1_des_report", "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "You give Des the last address. He still doesn\'t write it down." }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"That\'s the pair, then.\" He\'s pleased in a way that takes a second to read as pleased. \"Two people who\'ll have something by the weekend.\"" }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Archie all right? We go back — years, that. Had a bit of business once, sorted it out ages ago.\" He says it with the mild warmth of a man recalling a settled account, and moves on before you can ask which business." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "You ask who. He tells you the first names and nothing else, and you realise a beat later that he has told you exactly as much as he\'d tell anyone about you." }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Nobody\'s ever raided a vein they didn\'t know about.\" He says it as a small joke about paperwork. \"That\'s the whole trick. That\'s it. That\'s the entire clever bit.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "By the end of the week, both patches you found have veins in them and neither of them is yours. You are, apparently, fine with this, which is itself new information." }], "on_complete": [{ "op": "set_flag", "flag": "colA1DesThreadDone", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a1_des_report_first_fate": { "id": "col_a1_des_report_first_fate", "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "You give Des one address. He doesn\'t write it down." }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Fate. In the City, no less.\" He\'s pleased in a way that takes a second to read as pleased. \"That\'s one. Somebody\'ll have something by the weekend.\"" }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Still want physics off you an\' all. No rush — just don\'t go thinking that\'s the job done.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "By the end of the week, one patch you found has a vein in it and it isn\'t yours. You seem fine with this." }], "on_complete": [{ "op": "set_screen", "screen": "phone" }] }, "col_a1_des_report_first_physics": { "id": "col_a1_des_report_first_physics", "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "You give Des one address. He doesn\'t write it down." }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Physics. Good — that\'s somebody sorted by the weekend.\" He\'s pleased in a way that takes a second to read as pleased." }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Still want a fate patch off you an\' all. City, for preference — nobody round here\'s got the ground for it. No rush.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "By the end of the week, one patch you found has a vein in it and it isn\'t yours. You seem fine with this." }], "on_complete": [{ "op": "set_screen", "screen": "phone" }] }, "col_a1_firm_intimidation": { "id": "col_a1_firm_intimidation", "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "Three of them, waiting by your exit, in no particular hurry. The one in front has the patient look of somebody doing an errand." }, { "type": "speaker", "label": <null>, "speaker": "Firm Man", "text": "\"You\'ve been busy. Fate, physics — bit ambitious for someone who was doing a rent-a-vein in Whitechapel a month ago.\"" }, { "type": "speaker", "label": <null>, "speaker": "Firm Man", "text": "\"Nobody\'s asking you to stop. Just letting you know it\'s been noticed. There\'s a difference, and the difference is entirely up to you.\"" }, { "type": "choice", "label": <null>, "speaker": <null>, "text": "He hasn\'t threatened you. He\'s been very careful not to.", "choices": [{ "label": "Back off", "effects": [{ "op": "log_method", "key": "firmFirstContact", "value": "backed_off" }], "result_text": "You take the long way round. Nothing happens, which is the point — somebody wanted a face and now has one." }, { "label": "Hold your ground", "effects": [{ "op": "log_method", "key": "firmFirstContact", "value": "held" }], "result_text": "You don\'t move and you don\'t say anything. He waits, decides it isn\'t worth the afternoon, and they go. He is slightly less pleasant on the way past." }, { "label": "Tell them where to go", "effects": [{ "op": "log_method", "key": "firmFirstContact", "value": "fought" }, { "op": "start_street_mugging" }], "result_text": "You tell him. There is a moment where it could still go either way, and then it doesn\'t." }] }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "The patches are still yours to give away. That was never what this was about." }], "on_complete": [{ "op": "set_flag", "flag": "colA1IntimidationSeen", "value": true }, { "op": "set_screen", "screen": "map" }] }, "col_a1_firm_skirmish": { "id": "col_a1_firm_skirmish", "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "You come round the corner into the end of something. Four people, one of them on the floor, and the specific quiet that happens after shouting rather than before it." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "Two of them are wearing the kind of coats that cost money. They are not hurrying. One is writing something down." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "By the time you\'ve decided whether to do anything, there are two people and one of them is being helped into a car by the other. Nobody looks at you. It has been arranged that there is nothing to look at." }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You ask Des about it later. He says \"Firm,\" the way you\'d say \"rain,\" and asks whether you found anything." }], "on_complete": [{ "op": "set_flag", "flag": "colA1SkirmishSeen", "value": true }, { "op": "set_screen", "screen": "map" }] }, "col_a1_hakim_done": { "id": "col_a1_hakim_done", "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "The yard looks exactly the same. The vein does not. It reads as taking, and rising." }, { "type": "speaker", "label": <null>, "speaker": "Hakim", "text": "\"That\'s better than my uncle had it.\" He says this and then looks slightly stricken, as though he has been disloyal." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "He pays you. It is not very much and he has clearly thought about the amount, and there is no version of refusing it that isn\'t worse." }, { "type": "speaker", "label": <null>, "speaker": "Hakim", "text": "\"Listen. I hear things. Not — I\'m not anybody, I just stand here and people talk. If I hear about ground going, round here, I\'ll text you. That\'s not me paying you back, that\'s just — I\'ll text you.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You have made a newsagent\'s yard marginally more productive. Somewhere in the calculation of what you have spent your week on, this is either the least or the most important thing, and it won\'t be clear which for some time." }], "on_complete": [{ "op": "sell_contact_vein_to_faction", "veinIdStatePath": "collective.hakimVeinId", "faction": "collective", "price": 0 }, { "op": "add", "path": "player.cash", "value": 120 }, { "op": "faction_relation", "faction": "collective", "value": 10 }, { "op": "set_flag", "flag": "colA1HakimThreadDone", "value": true }, { "op": "set_flag", "flag": "hakimIntelUnlocked", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a1_hakim_meet": { "id": "col_a1_hakim_meet", "pin": { "district": "whitechapel", "showWhenFlagsTrue": ["colA1HubReached"], "showWhenFlagsFalse": ["colA1HakimMet"], "contact": "hakim", "phoneLabel": "Go and meet Hakim" }, "cards": [{ "type": "narration", "label": "Whitechapel Road", "speaker": <null>, "text": "The shop sells newspapers, phone credit, and a dozen kinds of crisps, among other things. There is a child\'s homework on the counter, half done, with a biro resting in the fold." }, { "type": "speaker", "label": <null>, "speaker": "Hakim", "text": "\"You\'re Des\'s. He said. Sorry - that came out like you\'re a dog.\"" }, { "type": "speaker", "label": <null>, "speaker": "Hakim", "text": "\"There\'s a vein in the yard. Came with the shop. My uncle had it and he was good with it and I\'m not, and it\'s been going backwards for about two years.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "The yard is eleven feet of concrete, three bins and a vein that has clearly not been touched in a long time. It reads as sparse and dropping." }, { "type": "speaker", "label": <null>, "speaker": "Hakim", "text": "\"It does about a third of what it used to. Which is about a third of the rent, so.\" He stops there, having got closer to complaining than he intended." }, { "type": "speaker", "label": <null>, "speaker": "Hakim", "text": "\"Des says you\'re good at the growing part. I can\'t pay you properly. I can pay you something.\"" }, { "type": "choice", "label": <null>, "speaker": <null>, "text": "Behind him, through the doorway, somebody\'s homework is still half done.", "choices": [{ "label": "I\'ll do it", "effects": [], "result_text": "\"Right. Good. Thank you.\" He busies himself with the till so neither of you has to be looking at the other." }, { "label": "You don\'t have to pay me", "effects": [], "result_text": "\"I do, though.\" He says it flatly, and it is the only time he has been immovable about anything. \"I\'ll pay you something. I\'m not having it be a favour.\"" }] }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You have taken on somebody\'s yard. It is not, in any measurable sense, a good use of your afternoons." }], "on_complete": [{ "op": "grant_contact_vein", "vein": { "oreType": "emotion", "growth": 18, "rampantDays": 0, "security": "none", "alarmUpgrades": [], "location": "Whitechapel Road, the yard behind the newsagent\'s", "district": "whitechapel", "hospitability": { "tier": "fair", "bonuses": [] } }, "statePath": "collective.hakimVeinId" }, { "op": "set_flag", "flag": "colA1HakimMet", "value": true }, { "op": "set_screen", "screen": "map" }] }, "col_a1_hub": { "id": "col_a1_hub", "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "Des has bought you a coffee you didn\'t ask for and won\'t let you pay for, which is becoming a pattern." }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Right. You\'ve had a fortnight of me giving you things. That\'s fine, that\'s how it works, but it works both ways or it doesn\'t work.\"" }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Three things. Take them in whatever order suits. Or don\'t — I\'m not your governor, nobody is.\"" }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"One\'s mine. We\'ve got people who can seed but haven\'t got ground. I need a fate patch and a physics patch, decent ones, and I need them left alone until I say. You find them, I\'ll do the rest.\"" }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Two\'s Nadia. Hackney. She moves more calc in a week than the rest of us see in a month and she\'s short on something. Go and be useful to her; she\'ll tell you how.\"" }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Three\'s Hakim. Newsagent, Whitechapel Road. He\'s got a vein in his yard that\'s on its way out and he hasn\'t got the hands for it. That one\'s not a favour to me, it\'s a favour to him, and he\'ll be embarrassed about it, so don\'t make it worse.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "He writes two phone numbers on the back of a receipt, which is the only record of any of this that will ever exist." }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "Three names, three problems, no deadline and no order. The Collective, as far as you can tell, is a group of people who have each independently decided to be helpful and have never once discussed it." }], "on_complete": [{ "op": "unlock_contact", "contact": "nadia" }, { "op": "unlock_contact", "contact": "hakim" }, { "op": "set_flag", "flag": "colA1DesThreadActive", "value": true }, { "op": "set_flag", "flag": "colA1HubReached", "value": true }, { "op": "set_flag", "flag": "colA1Stage", "value": "hub" }, { "op": "set_flag", "flag": "colA1ArchiePryAvailable", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a1_intro": { "id": "col_a1_intro", "cards": [{ "type": "narration", "label": "Shoreditch", "speaker": <null>, "text": "The footpath shines, wet from the recent rain. Archie is standing outside it with the expression of a man who has already had this conversation in his head and did not enjoy it." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"One vein. That\'s what we\'ve got. One vein, which is nice, but it\'s not enough.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"One vein isn\'t a business, it\'s a hobby with rent. You want more, you have to go and find ground, and seed it, and I can\'t teach you that because I\'ve never done it. I shift stock. I don\'t dig.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "He fishes his keys out - a fat bunch, a Millennium Falcon keyring worn smooth at the edges - and lets you both into the lock-up." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"So I called a bloke. He\'s good. He\'s the best I know at it, actually.\" A pause exactly long enough to be noticeable. \"He\'ll teach you. Then he\'ll go home.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "The man who comes in is in his forties, unhurried, with a canvas bag over one shoulder and the air of somebody who has never once been late but has often waited. He looks genuinely pleased to be here, which nobody else in this story has managed." }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Desmond. Des. You\'re the one with the Whitechapel time vein.\" He says it like a fact he\'s glad about rather than one he\'s checking." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Right. Des knows ground, I know buyers, and between us you might make rent. That\'s the arrangement.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "Archie does not offer Des tea. Des does not appear to expect any. There is a silence with some history in it, and then Archie remembers somewhere else he needs to be." }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"He\'s all right, Archie. Bit of a transaction, but he\'s all right.\" He\'s already unpacking the bag. \"Right. Ground.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You have a teacher. Neither of you has mentioned money, which, given your money troubles, is both a relief and slightly unsettling." }], "on_complete": [{ "op": "unlock_contact", "contact": "des" }, { "op": "set_flag", "flag": "colA1DesMet", "value": true }, { "op": "set_flag", "flag": "collectiveLaneUnlocked", "value": true }, { "op": "faction_relation", "faction": "collective", "value": 5 }, { "op": "set_flag", "flag": "colA1Stage", "value": "tuition" }, { "op": "notify", "text": "Des reckons there\'s ground worth a look. Check the map." }, { "op": "set_screen", "screen": "contacts" }] }, "col_a1_nadia_done": { "id": "col_a1_nadia_done", "cards": [{ "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"Right. That\'s mine now.\" She counts out the money in a way that suggests she has counted out a great deal of money in her life. \"And that\'s three days a fortnight back.\"" }, { "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"You\'ll get offers, by the way. People who want to buy ground off you cheap because you\'re new. Don\'t take them. Ask me first, I\'ll tell you what it\'s worth, and I\'ll tell you straight even when I\'m the one buying.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "You believe her, and you notice that you believe her, and you file that away." }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You have sold a vein. There\'s more money in your account than there was, and slightly less London that belongs to you. Feels like progress." }], "on_complete": [{ "op": "faction_relation", "faction": "collective", "value": 10 }, { "op": "set_flag", "flag": "colA1NadiaThreadDone", "value": true }, { "op": "set_screen", "screen": "vein_list" }] }, "col_a1_nadia_meet": { "id": "col_a1_nadia_meet", "cards": [{ "type": "narration", "label": "Hackney - the back of a shop that sells phone cases", "speaker": <null>, "text": "Nadia Beckford is about seventy and is moving a crate that you would need help with. She does not accept help." }, { "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"Des sent you. He\'s told you I\'m short.\" She doesn\'t look up. \"He\'s right. I\'m short.\"" }, { "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"Standing order. Time calc, every fortnight, same bloke, same amount, been running four years. It pays for a lot of things that need paying for.\"" }, { "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"This end of town\'s full of it and everyone round here has a bit and nobody has thirty units at once. So I spend three days on the phone every fortnight like it\'s 1974.\"" }, { "type": "choice", "label": <null>, "speaker": <null>, "text": "She finally looks up.", "choices": [{ "label": "I can get you thirty", "effects": [], "result_text": "\"Course you can.\" She goes back to the crate. \"Bring it when you\'ve got it. Bring it in bits, I don\'t care.\"" }, { "label": "What\'s in it for me?", "effects": [], "result_text": "\"Market rate, same as anyone.\" A pause. \"You were expecting me to be offended. I\'m not. Ask people what things cost, it saves everybody a fortnight.\"" }] }, { "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"And before you ask - no, I don\'t know who\'s holding what in the collective. Nobody does. If I knew who had what I\'d have had this done Tuesday.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "Thirty units of time calc, no deadline, no paperwork, and a woman who has been doing this since before you were born treating it as entirely routine." }], "on_complete": [{ "op": "set_flag", "flag": "colA1NadiaMet", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a1_nadia_vein": { "id": "col_a1_nadia_vein", "cards": [{ "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"That\'s the order filled and I\'m still doing three days on the phone every fortnight. That\'s not a solution, that\'s you being nice.\"" }, { "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"So. Different idea. You seed me a time vein and I buy it off you. Then it\'s mine, it produces, and the standing order fills itself.\"" }, { "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"You take the risk - the forty units, the seeding, whether it takes. I take a working vein and pay for it.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "It is the first time anyone in the Collective has proposed a transaction to you where both halves were named out loud, and it\'s oddly restful." }, { "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"Grow it a bit first if you\'ve any sense. I\'ll pay what it\'s worth on the day, and a hole in the ground with forty units in it isn\'t worth as much as something you\'ve cultivated.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You now know that a vein is a thing that can be sold, which had genuinely not occurred to you." }], "on_complete": [{ "op": "set_flag", "flag": "veinSaleUnlocked", "value": true }, { "op": "set_flag", "flag": "colA1NadiaAskSeen", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a1_prospecting": { "id": "col_a1_prospecting", "pin": { "district": "shoreditch", "showWhenFlagsTrue": ["colA1DesMet"], "showWhenFlagsFalse": ["colA1ProspectingTaught"], "contact": "des", "phoneLabel": "Go prospecting with Des" }, "cards": [{ "type": "narration", "label": "Shoreditch — a service yard behind a coffee place", "speaker": <null>, "text": "Des has brought you to the least interesting place in Shoreditch and is looking at it with open enthusiasm." }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Everyone looks for the dramatic bit. Cracked stone, old church, that sort of thing. Mostly what you want is somewhere that\'s been left alone a long time and had something happen to it once.\"" }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Prospecting\'s a block of your day and a walk about. You\'ll turn up a patch or you won\'t. What you turn up depends on the ground round here and on how much of this you\'ve done before — that\'s it, that\'s the whole system.\"" }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Patches come in grades. Poor, fair, rich, and once in a blue moon something that makes you sit down. Barren ones you leave; nothing takes in them.\"" }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Different parts of London tend to skew more to a specific type. Round here it\'s whatever\'s going. Whitechapel\'s emotion, mostly. The City\'s fate, which probably isn\'t much of a surprise.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "He does not tell you which of these facts is the important one. You get the sense this is on purpose." }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Go on. Have a look about. I\'ll be here.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You spend the better part of an hour looking at brickwork with a seriousness that would embarrass you if anyone you knew walked past. Somewhere under all of it, London is doing what it does." }], "on_complete": [{ "op": "set_flag", "flag": "colA1ProspectingTaught", "value": true }, { "op": "set_screen", "screen": "map" }] }, "col_a1_seeding": { "id": "col_a1_seeding", "pin": { "district": "shoreditch", "showWhenFlagsTrue": ["colA1ProspectingTaught"], "showWhenFlagsFalse": ["colA1SeedingTaught"], "contact": "des", "phoneLabel": "Go seed a patch with Des" }, "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "Des has a jar in his bag. In the jar is about forty units of somebody\'s physics calc, and he is holding it the way other people hold a thermos." }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Finding a patch is half of it. A patch is just good ground. It doesn\'t do anything until you put something in it.\"" }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Forty units of the right type. Has to match what the ground wants — you can\'t put fate in a life patch and hope. Costs you a block, and it doesn\'t always take. Better ground takes more often, and you get better at it.\"" }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"When it takes, you\'ve got a vein and the patch is yours. When it doesn\'t, you\'ve lost the calc and the afternoon, and you have another go when you can afford one.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "He says the last part without any particular weight, as a man describing weather." }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Which is why nobody round here seeds alone if they don\'t have to. If I\'ve got forty spare and you\'ve found ground, that\'s not me lending you anything. That\'s the ground getting used.\"" }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"The needs of the many outweigh the needs of the few.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "He does not appear to think he has said anything unusual, and moves straight on to the practical bit about matching types, which he has now explained twice." }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You know how to seed a patch. You do not yet have forty units of anything spare, which is a different problem and, Des would say, a smaller one." }], "on_complete": [{ "op": "set_flag", "flag": "colA1SeedingTaught", "value": true }, { "op": "queue_pending_message", "contact": "des", "kind": "col_a1_hub", "text": "When you\'ve got a minute. Nothing urgent, but there are three things." }, { "op": "set_screen", "screen": "map" }] }, "col_a2_contested_vein": { "id": "col_a2_contested_vein", "pin": { "district": "camden", "showWhenFlagsTrue": ["colA2Stage"], "showWhenFlagsFalse": ["colA2ContestedVeinDone"] }, "cards": [{ "type": "narration", "label": "Camden", "speaker": <null>, "text": "A lock-up off the market that used to be Collective ground. Somebody\'s changed the padlock. Nobody saw it happen, or nobody\'s saying." }, { "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"That one\'s the Firm\'s now. Since sometime after Hakim. Nobody rang to tell us - we just noticed the takings stopped.\"" }, { "type": "choice", "label": <null>, "speaker": <null>, "text": "Two ways to have it back.", "choices": [{ "label": "Take it back", "effects": [{ "op": "claim_faction_vein", "siteIdStatePath": "collective.contestedVeinSiteId" }, { "op": "log_method", "key": "a2ContestedVein", "value": "force" }], "result_text": "You go in like it\'s still yours, because it still should be. Nobody\'s there to argue. That doesn\'t mean nobody notices." }, { "label": "Buy it back", "effects": [{ "op": "buy_faction_vein", "siteIdStatePath": "collective.contestedVeinSiteId", "faction": "firm" }, { "op": "log_method", "key": "a2ContestedVein", "value": "bought" }], "result_text": "\"You want it back, there\'s a price, same as anyone\'s. We\'re not precious about it. It\'s only business, at the end of the day.\" He counts it without looking up. It is the least interesting thing that has happened to him all week." }] }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "Either way, the lock-up is yours again. Whether it feels like it is a separate question, for later." }], "on_complete": [{ "op": "set_flag", "flag": "colA2ContestedVeinDone", "value": true }, { "op": "set_screen", "screen": "map" }] }, "col_a2_handler_deferred": { "id": "col_a2_handler_deferred", "cards": [{ "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"There\'s a way to know before it happens. Costs money. Costs the right kind of money, mind, not the kind we\'re short of.\"" }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"No.\" A pause, because he\'s noticed how that sounded. \"Not because it\'s wrong. Because it\'s too soon.\"" }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"You start with \'just this once\' and you don\'t notice the year it stopped being once.\"" }, { "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "A pause, then \"Fine. We do it the hard way. For now\" " }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "Nobody writes it down, but it\'s agreed, the way things get agreed round here - once, out loud, and never mentioned again unless it stops holding." }], "on_complete": [{ "op": "set_flag", "flag": "colA2HandlerDeferred", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a2_intro": { "id": "col_a2_intro", "cards": [{ "type": "narration", "label": "Now", "speaker": <null>, "text": "Des writes full sentences. Punctuation, structure, the works. This wasn\'t that — four separate half-thoughts sent one after another, which is how you know something\'s wrong before you\'ve even read what it is." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "You don\'t reply. You\'re already moving." }], "on_complete": [{ "op": "set_screen", "screen": "contacts" }, { "op": "start_event", "event": "col_a2_shop" }] }, "col_a2_pattern": { "id": "col_a2_pattern", "cards": [{ "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"It\'s not just Hakim. Priya had someone on the phone about her window three days ago. Marcus actually got his window put through last week. Sef had a \'friendly visit\' from two blokes who complimented his stock.\"" }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Three separate visits inside a fortnight. Somebody decided we\'re worth the bother.\"" }, { "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"Right. Something needs doing. I don\'t much care what order - pick at it as it comes.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "Nobody says the word plan. It isn\'t that, not yet. It\'s three problems and a room full of people who\'d rather be doing something than talking about it." }], "on_complete": [{ "op": "set_flag", "flag": "colA2Stage", "value": "call" }, { "op": "set_screen", "screen": "contacts" }, { "op": "start_event", "event": "col_a2_handler_deferred" }] }, "col_a2_shop": { "id": "col_a2_shop", "cards": [{ "type": "narration", "label": "Whitechapel", "speaker": <null>, "text": "The shop\'s shutter is halfway down. The blind on the door is turned to closed." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "Hakim\'s on the stool behind the till, holding a tea towel full of ice from the freezer cabinet against his mouth. His lip\'s split. He keeps trying to talk properly around it." }, { "type": "speaker", "label": <null>, "speaker": "Hakim", "text": "\"I\'m fine,\" he says." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "Des and Nadia are already there. Des isn\'t shouting. He\'s gone quiet instead, which nobody in the room has seen him do before. It makes everything feel even more serious." }, { "type": "speaker", "label": <null>, "speaker": "Des", "text": "\"Two of them. Made an offer for the shop and what\'s under it. A fair price, they said.\"" }, { "type": "speaker", "label": <null>, "speaker": "Hakim", "text": "\"I said no.\" He tries to shrug and thinks better of it halfway through. \"They didn\'t love that.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "Nobody involved has a name yet. From the way Nadia\'s talking, you think that will change soon - this attack won\'t go unanswered." }], "on_complete": [{ "op": "set_flag", "flag": "colA2ShopSeen", "value": true }, { "op": "set_screen", "screen": "contacts" }, { "op": "start_event", "event": "col_a2_pattern" }] }, "col_a2_vulnerable_site": { "id": "col_a2_vulnerable_site", "pin": { "district": "whitechapel", "showWhenFlagsTrue": ["colA2Stage"], "showWhenFlagsFalse": ["colA2VulnerableSiteDone"] }, "cards": [{ "type": "narration", "label": "Whitechapel", "speaker": <null>, "text": "A railway arch nobody\'s bothered to lock properly in three years. It\'s held ore the whole time and nothing\'s ever gone wrong with it - yet." }, { "type": "speaker", "label": <null>, "speaker": "Nadia", "text": "\"That one\'s ours and it\'s soft as anything. It was fine while nobody\'s looking twice at us. We\'re past that now.\"" }, { "type": "choice", "label": <null>, "speaker": <null>, "text": "Two ways to leave it.", "choices": [{ "label": "Fund a lookout (£150)", "effects": [{ "op": "add", "path": "player.cash", "value": -150 }, { "op": "add", "path": "factions.collective.resources", "value": 150 }, { "op": "log_method", "key": "a2VulnerableSite", "value": "lookout" }], "result_text": "You put the money in, so someone doesn\'t need to pull a second shift and can spend it here, sitting on a crate near the arch most evenings, reading a paper without really reading it." }, { "label": "Stay soft and fast", "effects": [{ "op": "log_method", "key": "a2VulnerableSite", "value": "soft" }], "result_text": "You leave it as it is. Nobody\'s ever taken it before, and sometimes a lookout just draws more attention." }] }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "Either way, the vein keeps doing what it\'s always done, for now. Whether that keeps being true is a separate question." }], "on_complete": [{ "op": "set_flag", "flag": "colA2VulnerableSiteDone", "value": true }, { "op": "set_screen", "screen": "map" }] }, "col_hakim_intel": { "id": "col_hakim_intel", "cards": [{ "type": "speaker", "label": <null>, "speaker": "Hakim", "text": "\"Bloke came in for a Lucozade and wouldn\'t shut up about the yard behind the launderette. Might be nothing. Thought you\'d want it before somebody else does.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "It is on your map now. He will not mention it again and will be embarrassed if you thank him twice." }], "on_complete": [{ "op": "reveal_site" }, { "op": "set_hakim_intel_day" }, { "op": "set_screen", "screen": "phone" }] }, "conclave_watch": { "id": "conclave_watch", "cards": [{ "type": "narration", "label": "The City", "speaker": <null>, "text": "A man in a good coat stands very still outside a bank that isn\'t a bank, watching nothing in particular with the specific attention of someone paid to watch nothing in particular. He doesn\'t look at you. That\'s how you know he\'s looked at you." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "By the time you think to look back properly, he\'s gone, and the space he was standing in has already been filled by three tourists and a Deliveroo rider, as if London itself hurried to paper over the gap." }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You add it to a growing list of things about the City you\'re choosing not to think about too hard." }], "on_complete": [{ "op": "set_flag", "flag": "conclaveNoticed", "value": true }, { "op": "set_screen", "screen": "map" }], "deck": { "district": "city", "weight": 1, "excludeIfFlag": "conclaveNoticed", "barometerState": <null> } }, "foxes": { "id": "foxes", "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "A fox crosses your path at the exact midpoint between two streetlights, pauses to look at you with total lack of interest, and continues on business you\'ll never be briefed on. London\'s real nightshift clocks on. You\'re not on the rota." }], "on_complete": [{ "op": "set_screen", "screen": "map" }], "deck": { "district": "any", "weight": 1, "excludeIfFlag": <null>, "barometerState": <null> } }, "heath_dogwalker": { "id": "heath_dogwalker", "cards": [{ "type": "narration", "label": "Hampstead Heath", "speaker": <null>, "text": "An older woman with four dogs and the bearing of a small aristocracy nods at you like you\'re expected. One of the dogs sniffs your bag with professional interest." }, { "type": "speaker", "label": <null>, "speaker": "Dogwalker", "text": "\"You\'re doing the ore thing, aren\'t you. Everyone up here can tell. Here - Wellington dug this up under an oak.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "She\'s gone before you can ask which dog is Wellington. All four look equally capable of digging up the past." }], "on_complete": [{ "op": "add_ore", "type": "life", "qty": 2 }, { "op": "set_screen", "screen": "map" }], "deck": { "district": "hampstead", "weight": 1, "excludeIfFlag": <null>, "barometerState": <null> } }, "home_raid_debrief_loss": { "id": "home_raid_debrief_loss", "cards": [{ "type": "tension", "label": "Later", "speaker": <null>, "text": "You come round on the floor. Your ore is gone. The window is open. The rest of the place looks ransacked, though in hindsight it isn\'t too dissimilar to how it was before; you should probably tidy up a bit more often." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "Archie arrives at seven in the morning. He takes one look at you and puts the coffees down without saying anything for a moment." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Right. How much did they get?\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"Most of it.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Yeah.\" He sits down. \"This place is a problem. I\'ve been meaning to say something for a while. One lock. Window doesn\'t close. It\'s practically a service entrance.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"You alright, though? Properly?\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"I\'m fine.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Good. Because here\'s the thing - you\'re still here, you still fought back, and that counts for something. I\'ve worked with people who\'d have just handed it over.\" He pauses. \"Some of them were me, early on.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"I think it\'s time we made this official. Partners. Properly. Which means I\'ve got a responsibility to make sure you\'re not operating out of a place someone can stroll into at three in the morning.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Got a bloke who does security - good stuff, fair price, no paperwork. And you need to start thinking about moving somewhere better. This is the kind of place that keeps happening to you until you leave it.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"And - the vein. Time vein, Whitechapel. I said I\'d give it to you and I meant it. It\'s barely tapped. Needs cultivating before it\'ll produce anything, but it\'s a start. Build it up, prune it, make pearls. I\'ll sort the buyers.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "He stays until you\'ve eaten something, which you didn\'t ask for and didn\'t expect. Then he leaves. You check your phone. There\'s a pin location. The vein." }], "on_complete": [{ "op": "set_flag", "flag": "homeRaidEventSeen", "value": true }, { "op": "set_flag", "flag": "homeRaidWon", "value": false }, { "op": "set_flag", "flag": "archiePartnerSeen", "value": true }, { "op": "set_flag", "flag": "homeUnlocked", "value": true }, { "op": "set_flag", "flag": "securityContactUnlocked", "value": true }, { "op": "relation", "contact": "archie", "value": 10 }, { "op": "grant_vein_with_site", "vein": { "oreType": "time", "growth": 20, "rampantDays": 0, "security": "none", "alarmUpgrades": [], "location": "Whitechapel, behind the old brewery", "district": "whitechapel", "hospitability": { "tier": "fair", "bonuses": [] } } }, { "op": "notify", "text": "HQ\'s workbench is open now." }, { "op": "set_screen", "screen": "phone" }] }, "home_raid_debrief_win": { "id": "home_raid_debrief_win", "cards": [{ "type": "resolution", "label": "Forty minutes later", "speaker": <null>, "text": "The police were called by a neighbour and left without much interest. You gave a statement that was technically accurate in every detail that didn\'t matter. The raider is gone. Your ore is still here." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "Archie arrives at seven in the morning with two coffees and the air of a man who has absolutely expected this." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"You alright?\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"Yeah. They didn\'t get anything.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Good. That\'s good.\" He looks around the flat. \"This place is a liability, you know that? One lock on the door and a window that doesn\'t close properly. You might as well put a sign up.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Anyway. You handled yourself, which is — honestly, that\'s more than I expected. No offence.\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"Some offence.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Fair. Look — this has made me think. We\'ve been doing well together. You\'ve been reliable, which in this line of work is genuinely rare. I think we should make it proper.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Official partners. Means I look out for you, you look out for me. And it means I can call in a favour — got a bloke who does security installs. Good gear, reasonable price, he doesn\'t ask questions. I\'ll have him round.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Also — and this is me being straight with you — you need to move. This place is done. Save up, find somewhere better. Nicer area, proper security, somewhere people can\'t just walk into at three in the morning.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"And — the vein. I said I\'d transfer it. Consider it done. Time vein, Whitechapel. It needs work before it\'ll produce anything, but it\'s yours. Cultivate it up, prune what you can, make pearls. I\'ll handle the buyers.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "He finishes his coffee and leaves before you can thank him, which is probably how he prefers it. You check your phone. There\'s a pin location. The vein." }], "on_complete": [{ "op": "set_flag", "flag": "homeRaidEventSeen", "value": true }, { "op": "set_flag", "flag": "homeRaidWon", "value": true }, { "op": "set_flag", "flag": "archiePartnerSeen", "value": true }, { "op": "set_flag", "flag": "homeUnlocked", "value": true }, { "op": "set_flag", "flag": "securityContactUnlocked", "value": true }, { "op": "relation", "contact": "archie", "value": 10 }, { "op": "grant_vein_with_site", "vein": { "oreType": "time", "growth": 20, "rampantDays": 0, "security": "none", "alarmUpgrades": [], "location": "Whitechapel, behind the old brewery", "district": "whitechapel", "hospitability": { "tier": "fair", "bonuses": [] } } }, { "op": "notify", "text": "HQ\'s workbench is open now." }, { "op": "set_screen", "screen": "phone" }] }, "home_raid_intro": { "id": "home_raid_intro", "cards": [{ "type": "tension", "label": "3:14 AM", "speaker": <null>, "text": "Something woke you up. You lie still for a moment, cataloguing the sounds of the building. The boiler. A fox outside. Then: footsteps, not from the corridor. From inside." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "Your flatmates are out this whole week, but someone\'s in the flat. Moving carefully, which is almost worse than if they were crashing around - it means they\'ve done this before." }, { "type": "tension", "label": <null>, "speaker": <null>, "text": "You grab the nearest thing to hand - which, for better or worse, is the torch you left by the bed after last week when the power went out. After what feels like an eternity, your bedroom door slowly opens. You swing and feel the crack more than you hear it. THe intruder reels, then jumps at you." }], "on_complete": [{ "op": "start_home_raid_combat" }] }, "intro": { "id": "intro", "cards": [{ "type": "narration", "label": "Earlier tonight — Whitechapel", "speaker": <null>, "text": "Rent is due Friday. The job search has been exhausting and fruitless. You have forty quid left in your account. An old friend, Archie, said he might be able to help. So here you are, behind a chicken shop on Mile End Road at half ten on a Tuesday, while Archie holds a plastic Tesco bag with what looks like an opened Amazon box inside." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "The buyers arrive in a grey Vauxhall. Three of them. That\'s one more than Archie mentioned. He notices too - you can tell by the way he stops whistling.", "image": "res://assets/events/intro/1.jpg" }, { "type": "tension", "label": "It goes wrong", "speaker": <null>, "text": "The one nearest to you produces a Stanley knife. His mate walks towards Arch and the bag. The third one just stands there, which is somehow worse. Archie says, very quietly: \"Yeah, okay.\"", "image": "res://assets/events/intro/2.jpg" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Alright chaps?\" he lifts the arm with the bag to wave, drawing everyone\'s eyes. You notice the other hand slip smoothly into his back pocket and pull something small out." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "He doesn\'t even move his arm, just flicks his wrist in a practiced motion and whatever he was holding flies through the air. Only one of the thugs even clocks it, eyes tracing it as it lands harmlessly on the ground between him and his mates. It shatters. The air around the three men goes thick and syrupy. They slow. Not stop - but slow, like a video buffering. Archie wraps the Tesco bag handle around his hand and walks, briskly, to the exit of the alley." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Coming, or what?\"" }, { "type": "resolution", "label": "Fifteen minutes later — a Wetherspoons", "speaker": <null>, "text": "Archie orders two pints and a portion of chips. You sit down opposite him. Neither of you say anything until the chips arrive.", "image": "res://assets/events/intro/3.png" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"What the hell was that?\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Orichalchum. Time-type. Slows things down in a radius - maybe four, five seconds of real time bought, if you compress it right. Was my last one, actually, so cheers for that\". He raises his pint to the door, as though saluting the muggers." }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"Is that... magic?\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Nah\". He sips his pint, \"Well, almost. It\'s basically magic. Don\'t make a big deal out of it. It\'s just like any product-  some people source it, some people turn it into something useful, some people use it. In between all that, people like us can make a quid or two connecting them. If we\'re lucky.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Look. You need rent money. I need someone who isn\'t a liability. Come out with me tomorrow - I\'ve still got the calc from tonight, and I need to move it properly. I\'d feel better doing so with backup. You in?\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "You sigh, thinking about your bank balnace. \"Yeah.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Good. I\'ll text you in the morning. Don\'t do anything that ends you up in hospital before then.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "He finishes his pint and leaves. You sit with what\'s left of your pint, the chips, and the fact that your rent problem has somehow become a different problem entirely.", "image": "res://assets/events/intro/4.png" }], "on_complete": [{ "op": "set_flag", "flag": "metArchie", "value": true }, { "op": "set_stage", "value": "buyer_event" }, { "op": "set_screen", "screen": "phone" }] }, "james_meeting": { "id": "james_meeting", "cards": [{ "type": "narration", "label": "Two days later — Bermondsey", "speaker": <null>, "text": "The address Archie texted is a storage unit beside a halal supermarket. You find him leaning against the corrugated shutter, hands in pockets, looking like he\'s waiting for a bus he knows is going to be late." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "The man who opens the shutter is in his sixties. Glasses with one slightly bent arm, a cardigan that has seen things. He looks at the two of you over the rim of his lenses with the specific expression of someone whose time is being wasted — and who has decided, provisionally, to allow it." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"James. Cheers for this. This is — well, he\'s helping me out at the moment.\"" }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"Yes. I can see that. Come in, then. Don\'t touch anything.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "Inside: shelves of labelled jars, a workbench covered in instruments that look like someone crossed a chemistry set with an antique shop. It smells of copper and something you can\'t name." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "You lean in toward a row of sealed jars. One of them contains something that shifts — not from the movement of the shelf, not from any air in the room. It moves, very slightly, as if it noticed you." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "You glance up. James is watching you. His expression doesn\'t change, exactly. But something in it does." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"He\'s the best craftsman I know. Turns raw calc into — well, you\'ve seen what the pearls do.\"" }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"Don\'t flatter me. I\'m the only craftsman you know. There\'s a difference.\" He turns to Archie. \"I have an order I need moved, but lack the time to do it. I\'ll give you the next batch of pearls - at cost - if you pick up a supply run for me. Stratford, in 45 minutes.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Yeah, alright. What am I picking up?\"" }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"Physics calc, forty units. The address will be on your phone by the time you\'re at Stratford station.\" He sets down the jar he\'s holding. \"Your associate stays here.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Right.\" He\'s already moving toward the door. \"Cheers, James. Back in a bit.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "The door closes. James stands in the silence for a moment, regarding you with the careful expression of a man who has decided to do something he hasn\'t fully justified to himself yet." }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"I have a substantial order for time pearls. My usual assistant is indisposed. You\'ll do.\" A pause. \"I realise that isn\'t flattering. It isn\'t meant to be.\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"I don\'t know how to make them.\"" }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"Evidently. That is why I am going to explain it to you, slowly, using small words. Even a reasonably attentive puppy could manage this. I\'m trusting you to clear that bar.\"" }, { "type": "craft", "label": "Crafting: Time Pearl", "speaker": <null>, "text": "James walks you through it. Time orichalchum, compressed into a glass sphere under controlled conditions. The calc does most of the work - you\'re just the hands. The sphere seals itself when it\'s ready. Or it doesn\'t, and the calc disperses. That\'s it, really." }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"The quality of the pearl depends on how cleanly you compress it. Rushed work means the time effect is weak and will last perhaps a few seconds. Patient, careful work produces something that can freeze a situation for longer. You will, at first, be rushing it. That\'s fine. You\'ll improve. Probably.\"" }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"And do try your very best not to fuck it up. The calc isn\'t free.\"" }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"You know, Plato described orichalchum as the second most precious metal in Atlantis. Wrote about it in the Critias  - considered it almost mystical in nature.\" He pauses. \"You have absolutely no idea what the Critias is, do you.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "It isn\'t really a question. You don\'t answer it." }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"It doesn\'t matter. The point is that people have understood what this material is for approximately two and a half thousand years, and we still have people like Archie picking up deliveries outside a Poundland in Stratford. Make of that what you will.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You spend two hours at the bench. Some of the pearls work. Some don\'t. James says nothing about the ones that don\'t, which is both surprising and a little unsettling." }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You leave with a crafting kit, a basic understanding of time pearl compression, and the distinct impression that James noticed something - and has decided, for now, not to mention it." }], "on_complete": [{ "op": "add_item", "item": "timePearl", "qty": 2 }, { "op": "set_flag", "flag": "metJames", "value": true }, { "op": "set_flag", "flag": "craftingUnlocked", "value": true }, { "op": "add", "path": "contacts.james.unlocked", "value": true }, { "op": "relation", "contact": "james", "value": 10 }, { "op": "set_stage", "value": "archie_craft_chat" }, { "op": "queue_pending_message", "contact": "archie", "kind": "archie_craft_chat", "text": "Oi — how\'d it go with James? Come find me." }, { "op": "add", "path": "world.archieChatUnlockDay", "value": 1 }, { "op": "set_screen", "screen": "phone" }] }, "james_motion": { "id": "james_motion", "cards": [{ "type": "narration", "label": "Bermondsey — the storage unit", "speaker": <null>, "text": "James opens the door in what you\'re coming to recognise as his default expression: mild disappointment that the world continues to contain other people." }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"You again.\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"I wanted to ask if you\'d be willing to teach me any other recipes. I\'ve been practising. I\'m better with the pearls now.\"" }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"I\'m sure you are. Mediocrity tends to plateau early. What\'s in it for me?\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"If you\'ve got more orders than you can handle, I could take the overflow. Or just do the grunt work - the basic stuff that takes your time without needing your skill.\"" }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "James looks at you for a long moment. He picks up a glass sphere from his bench, turns it over, sets it down again. This appears to be how he thinks." }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"You are proposing to be my assistant.\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"If that\'s how you want to frame it.\"" }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"I want to frame it accurately. You would not be a partner, a student, or a colleague. You would handle simple orders. I would retain all complex work. You would not advertise yourself as my associate.\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"That\'s fine.\"" }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"Hm.\" Another pause. \"Enhancement powder. It\'s straightforward. Life orichalchum, compressed differently to the pearls - outward rather than inward. Rub a small amount on the skin before physical exertion. Temporarily accelerates the user\'s movement.\"" }, { "type": "craft", "label": "New recipe: Enhancement Powder", "speaker": <null>, "text": "The compression is different from pearls. You\'re squeezing the calc by pushing the vice handle until your hands hurt, then gently scraping it to collect the powder. The result is a fine iridescent dust. James demonstrates once. He expects you to manage after that." }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"Quality scales with skill, as always. Low-grade powder gives you an edge over the average Joe. Better quality powder could make a couch potato compete with Usain Bolt. I trust you understand the principle.\"" }, { "type": "speaker", "label": <null>, "speaker": "James", "text": "\"I\'ll send you work when I have overflow. Don\'t expect it to be glamorous. And don\'t be late.\"" }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You leave with the recipe and the firm sense that James considers this arrangement a concession rather than a collaboration. You suspect that won\'t change." }], "on_complete": [{ "op": "set_flag", "flag": "jamesMotionEventSeen", "value": true }, { "op": "set_flag", "flag": "enhancementUnlocked", "value": true }, { "op": "relation", "contact": "james", "value": 1 }, { "op": "set_screen", "screen": "contacts" }] }, "kx_delay": { "id": "kx_delay", "cards": [{ "type": "narration", "label": "King\'s Cross", "speaker": <null>, "text": "The departures board changes its mind for the fourth time. Somewhere behind the barriers, a Tannoy voice apologises for something it clearly isn\'t sorry about." }, { "type": "choice", "label": <null>, "speaker": <null>, "text": "Everyone\'s on the King\'s Cross deal. You are, for once, one of the delayed rather than the delighted.", "choices": [{ "label": "Wait it out", "effects": [{ "op": "lose_time_block" }], "result_text": "You wait. Time passes the way it only does in stations — all of it, somehow, at once." }, { "label": "Pay for a cab (£30)", "effects": [{ "op": "add", "path": "player.cash", "value": -30 }], "result_text": "You pay. The driver has opinions about the Northern line. You did not ask for them." }] }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "Either way, you get where you\'re going. King\'s Cross remains, structurally, on its way somewhere else." }], "on_complete": [{ "op": "set_screen", "screen": "map" }], "deck": { "district": "kingscross", "weight": 1, "excludeIfFlag": <null>, "barometerState": <null> } }, "pigeon_omen": { "id": "pigeon_omen", "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "A pigeon lands directly on your bag, considers you with the flat, ancient judgement pigeons reserve for people who look like they\'re up to something, and doesn\'t move." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "You\'ve heard the stories — fate-types collect near omens the way flies collect near anything else. You have no idea if this counts. The pigeon, notably, does not clarify." }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "It flies off eventually, satisfied or bored, impossible to say which. You feel, absurdly, like your next piece of luck has already been decided somewhere above you." }], "on_complete": [{ "op": "set_flag", "flag": "luckyOmen", "value": true }, { "op": "set_screen", "screen": "map" }], "deck": { "district": "any", "weight": 1, "excludeIfFlag": <null>, "barometerState": <null> } }, "rain": { "id": "rain", "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "It starts raining the specific, personal way London rain does — not weather so much as a verdict. Nobody around you reacts; rain is not news here. You\'re soaked by the time you find shelter, mildly impressed at how quickly the city returns to pretending it didn\'t just do that." }], "on_complete": [{ "op": "set_screen", "screen": "map" }], "deck": { "district": "any", "weight": 1, "excludeIfFlag": <null>, "barometerState": <null> } }, "rival_prospector": { "id": "rival_prospector", "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "Someone else has clearly had the same idea about this patch of ground, and unlike you, they\'ve brought company." }, { "type": "speaker", "label": <null>, "speaker": "Rival", "text": "\"Friendly notice. We\'re taking an interest in the good plot round here. A hundred quid says our interest fades. Your call.\"" }, { "type": "choice", "label": <null>, "speaker": <null>, "text": "He says \"friendly\" the way people say it right before it stops being true.", "choices": [{ "label": "Pay them off (£100)", "effects": [{ "op": "add", "path": "player.cash", "value": -100 }], "result_text": "He pockets it without counting it, which is somehow more insulting than if he had. \"Pleasure doing business,\" he says, in the tone of a man who has never once meant that sentence." }, { "label": "Let them have it", "effects": [{ "op": "npc_claim_best_unclaimed_site" }], "result_text": "You shrug and walk off. By the time you\'re back, someone else\'s flag is already in the ground on the best plot going." }] }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "London rewards neither generosity nor spite. It just carries on." }], "on_complete": [{ "op": "set_screen", "screen": "map" }], "deck": { "district": "any", "weight": 1, "excludeIfFlag": <null>, "barometerState": <null>, "requireUnclaimedSiteInDistrict": true } }, "roman_brick": { "id": "roman_brick", "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "Half-buried in the churned ground of wherever you\'re standing is a brick — old, red, unmistakably Roman — in a spot with no plausible Roman history whatsoever." }, { "type": "narration", "label": <null>, "speaker": <null>, "text": "You\'ve seen one of these before. You didn\'t think anything of it then either. That\'s probably the point." }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "You leave it where it is. Whatever\'s underneath London doesn\'t need your help finding daylight." }], "on_complete": [{ "op": "add", "path": "flags.oddities", "value": 1 }, { "op": "set_screen", "screen": "map" }], "deck": { "district": "any", "weight": 1, "excludeIfFlag": <null>, "barometerState": <null> } }, "shoreditch_archie": { "id": "shoreditch_archie", "cards": [{ "type": "narration", "label": <null>, "speaker": <null>, "text": "Archie appears the way he always does - already mid-sentence, as though the conversation started before you arrived and you\'re just catching up." }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"Hello hello. Fancy seeing you here. You look like someone currently doing something mildly reckless. Carry on. I\'m not your mum.\"" }, { "type": "speaker", "label": <null>, "speaker": "You", "text": "\"Comforting.\"" }, { "type": "speaker", "label": <null>, "speaker": "Archie", "text": "\"I do try.\" He nods once, like that\'s the whole conversation, and drifts back into whatever he was doing before he clocked you." }], "on_complete": [{ "op": "relation", "contact": "archie", "value": 2 }, { "op": "set_screen", "screen": "map" }], "deck": { "district": "any", "weight": 1, "excludeIfFlag": <null>, "barometerState": <null> } }, "soho_tout": { "id": "soho_tout", "cards": [{ "type": "narration", "label": "Soho", "speaker": <null>, "text": "A man with a laminated card and the unkillable optimism of the professionally rejected steps into your path. \"Members\' bar, love — and word is there\'s a proper market coming to Soho too. Ore, gear, all sorts. Not yet, but soon. You\'ll want to be first.\" He\'s gone before you can ask what \"soon\" means in Soho years." }], "on_complete": [{ "op": "set_screen", "screen": "map" }], "deck": { "district": "soho", "weight": 1, "excludeIfFlag": <null>, "barometerState": <null> } }, "vein_raid": { "id": "vein_raid", "cards": [{ "type": "tension", "label": "Night work", "speaker": <null>, "text": "Whoever\'s sitting on this vein hasn\'t put a name to it, but the ground still belongs to someone. You case the approach twice. No obvious watchers. That\'s not the same as no watchers." }, { "type": "choice", "label": <null>, "speaker": <null>, "text": "One way in. You commit or you don\'t.", "choices": [{ "label": "Go slow", "effects": [{ "op": "stealth_check", "consumable_bonus": 0.05, "on_success": [{ "op": "set_flag", "flag": "raidCaught", "value": false }, { "op": "notify", "text": "No alarms. You\'re in clean." }], "on_caught": [{ "op": "set_flag", "flag": "raidCaught", "value": true }, { "op": "notify", "text": "Something moves that shouldn\'t. You\'ve been seen." }, { "op": "start_raid_combat", "guards": 1, "template": "veinGuard" }] }], "result_text": "You take it slow — weight off every floorboard, timing the dark between passes." }, { "label": "Go fast", "effects": [{ "op": "stealth_check", "consumable_bonus": -0.05, "on_success": [{ "op": "set_flag", "flag": "raidCaught", "value": false }, { "op": "notify", "text": "No alarms. You\'re in clean." }], "on_caught": [{ "op": "set_flag", "flag": "raidCaught", "value": true }, { "op": "notify", "text": "Something moves that shouldn\'t. You\'ve been seen." }, { "op": "start_raid_combat", "guards": 1, "template": "veinGuard" }] }], "result_text": "You go in fast. Hesitation is what gets people caught, or so you tell yourself." }] }, { "type": "choice", "label": <null>, "speaker": <null>, "text": "The vein\'s yours to deal with, however you got here.", "choices": [{ "label": "Claim it", "effects": [{ "op": "claim_raid_vein" }], "result_text": "You take it outright. Word gets round fast — it always does — and the relationship with whoever ran this patch takes the hit that comes with being seen to do it." }, { "label": "Loot and leave", "effects": [{ "op": "loot_raid_vein" }], "result_text": "You take what you can carry and leave the rest where it stands. Someone else\'s problem, still." }] }], "on_complete": [{ "op": "set_screen", "screen": "map" }] }, "whitechapel_grief": { "id": "whitechapel_grief", "cards": [{ "type": "narration", "label": "Whitechapel", "speaker": <null>, "text": "Whitechapel keeps its grief the way other places keep street furniture — permanent, load-bearing, mostly ignored. You feel it anyway, a low hum under the emotion-type in your bag." }, { "type": "resolution", "label": <null>, "speaker": <null>, "text": "It passes, the way all inherited grief eventually does — not gone, just filed. The emotion-type in your bag sits heavier when you stand up, like it\'s been listening the whole time." }], "on_complete": [{ "op": "add_ore", "type": "emotion", "qty": 1 }, { "op": "set_screen", "screen": "map" }], "deck": { "district": "whitechapel", "weight": 1, "excludeIfFlag": <null>, "barometerState": <null> } } }, expected { "archie_craft_chat": { "cards": [{ "label": "A few days later — Spitalfields Market", "speaker": <null>, "text": "Archie is eating a falafel wrap and looking at his phone. He waves you over without looking up, which is either comfortable familiarity or mild rudeness. Probably both.", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"Alright. How\'d it go with James, then?\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"He taught me how to make the pearls. Basic stuff, but — it worked.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "Archie stops chewing. He looks at you with an expression you haven\'t seen on him before: genuine surprise.", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"He actually showed you? How to craft?\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"Yeah. Why?\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Because James doesn\'t show people things. James does things, judges people for not knowing how to do them, and considers that a complete interaction. Either he was absolutely desperate, or —\" He tilts his head. \"He saw something worth the bother.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Don\'t let it go to your head. You\'re at the bottom of a very long ladder. James has been at this for thirty years and he still considers himself underappreciated, which should tell you something about the ceiling.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"That said — keep practising. Seriously. Being able to craft your own means you\'re not at the mercy of James\'s prices, which frankly are a war crime. And it\'s a marketable skill.\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"Marketable how?\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Same way the ore is. There\'s buyers for finished product too — people who want pearls and don\'t have a James. I can start lining them up. Anything you make that you don\'t need, bring it to me. We split it down the middle, same as the calc.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "He finishes his wrap and bins the wrapper from four metres away. It goes in first time. He doesn\'t acknowledge this at all.", "type": "resolution" }], "id": "archie_craft_chat", "on_complete": [{ "flag": "archieCraftChatSeen", "op": "set_flag", "value": true }, { "flag": "canSellConsumables", "op": "set_flag", "value": true }, { "op": "set_stage", "value": "free" }, { "contact": "archie", "op": "relation", "value": 5 }, { "op": "add_ore", "qty": 20, "type": "time" }, { "flag": "homeRaidEventPending", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "archie_cultivation": { "cards": [{ "label": "Whitechapel — behind the old brewery", "speaker": <null>, "text": "The vein is exactly where the pin said: a hairline crack in old brick, humming faintly at a frequency you\'d ignore if you didn\'t already know what you were listening for. Archie\'s waiting with his hands in his pockets, doing an impression of a man who has never once stood around looking impatient.", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"Right. It\'s yours now, so you should know how it actually works, not just what the app tells you.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"See that number on it? Growth. Runs nought to a hundred, dead centre at fifty. Leave it be and it drifts — climbs if it was already climbing, sinks if it was already sinking. Doesn\'t just sit there, whatever you do.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Cultivate pushes it up. Put a session in — might take, might not, that part\'s down to your own skill. Land it low and it jumps a fair way; land it near the top and you\'re barely nudging it. Miss, and you\'ve lost nothing but the time.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Prune\'s how the calc actually comes out, and it only pays once you\'re past fifty. Light prune takes a bit, leaves the rest growing. Hard prune takes more, sets it right back — more calc for your trouble, mind.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Run one all the way down and leave it there, and it won\'t wait patient for you — spent long enough, it just collapses and disappears on you. The patch stays, mind, ready to seed again — it\'s the vein you lose.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"So don\'t get greedy on something you can\'t afford to lose. Go on, then — put a session in. I\'ll watch, so you don\'t feel like you\'re talking to brick.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "You work the vein the way he showed you. It takes, first go — beginner\'s luck, or possibly just Archie standing close enough to make failure socially awkward. The growth number ticks up. Somewhere under Whitechapel, something that used to belong to someone else settles into belonging to you.", "type": "resolution" }, { "label": <null>, "speaker": "Archie", "text": "\"There. Not complicated. Keep at it, and don\'t tell anyone else where it is.\"", "type": "speaker" }], "id": "archie_cultivation", "on_complete": [{ "op": "tutorial_cultivate" }, { "contact": "archie", "op": "relation", "value": 2 }, { "flag": "cultivationTutorialSeen", "op": "set_flag", "value": true }, { "contact": "archie", "kind": "col_a1_intro", "op": "queue_pending_message", "text": "Come by the lock-up. Got someone you need to meet. Don\'t make a thing of it." }, { "op": "set_screen", "screen": "map" }], "pin": { "contact": "archie", "district": "whitechapel", "phoneLabel": "Go and see Archie about the vein", "showWhenFlagsFalse": ["cultivationTutorialSeen"], "showWhenFlagsTrue": ["archiePartnerSeen"] } }, "archie_motion": { "cards": [{ "label": "A message from Archie", "speaker": <null>, "text": "You\'ve been moving product. It\'s working. Archie\'s text simply says: \"good output. call me.\"", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"So the consumables are going well. Got a buyer asking for more pearls and asking if there\'s anything else on offer. Which made me think — can you make anything else?\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"Not yet. James only taught me the pearls.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Yeah. Right. See, James knows how to make about forty different things and he\'s sitting on all of it. Which is his prerogative, obviously. But I\'m thinking — have you got any sort of relationship with him yet? Because it might be worth asking.\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"Asking him to teach me more?\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Gently. James doesn\'t respond well to being asked for things directly. Try framing it as being useful to him. Which, actually, you could be — if he\'s got orders he can\'t fill, you could take the overflow. Might be the angle.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Worth a try anyway. He\'s the only craftsman I know who isn\'t either retired or in prison, so options are limited.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "He hangs up before you can ask anything else. You look up James\'s address in your phone.", "type": "resolution" }], "id": "archie_motion", "on_complete": [{ "flag": "archieMotionEventSeen", "op": "set_flag", "value": true }, { "contact": "james", "kind": "james_motion", "op": "queue_pending_message", "text": "Overflow work, if you\'re capable of it. Come by." }, { "op": "set_screen", "screen": "contacts" }] }, "battersea_hum": { "cards": [{ "label": "Battersea", "speaker": <null>, "text": "The old power station hasn\'t generated anything since before your parents were your age, and it still hums, very faintly, like a tooth that\'s been pulled but hasn\'t told the nerve yet.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "You put your hand flat against the brick for exactly as long as feels socially acceptable to touch a decommissioned building, and come away with a faint charge of physics-type static in your palm.", "type": "resolution" }], "deck": { "barometerState": <null>, "district": "battersea", "excludeIfFlag": <null>, "weight": 1 }, "id": "battersea_hum", "on_complete": [{ "op": "add_ore", "qty": 1, "type": "physics" }, { "op": "set_screen", "screen": "map" }] }, "busker_greenwich": { "cards": [{ "label": "Greenwich Market", "speaker": <null>, "text": "By the market, a busker inflates himself explaining the finer points of the zero meridian to a strictly disinterested crowd. He clocks you before you clock him.", "type": "narration" }, { "label": <null>, "speaker": "Busker", "text": "\"You look like someone who deals in the good stuff. I know things - like where some small timers may have stashed some calc. Worth twenty quid to a man who knows how to spend it.\"", "type": "speaker" }, { "choices": [{ "effects": [{ "op": "add", "path": "player.cash", "value": -20 }, { "op": "add_ore", "qty": 1, "type": "time" }, { "flag": "greenwichTipOff", "op": "set_flag", "value": true }], "label": "Give him £20", "result_text": "He pockets the note and taps the side of his nose. \"Bus stop outside the McDonalds. Paving stone next to the bench is loose; lift it up and you\'ll get a nice surprise\". Funnily, he\'s telling the truth; there\'s a small stash of calc. Or more accurately, there WAS a small stash of calc." }, { "effects": [], "label": "Keep walking", "result_text": "You keep walking. He shouts something about the Meridian after you. You don\'t catch it, and don\'t ask him to repeat it." }], "label": <null>, "speaker": <null>, "text": "He\'s either got something, or he\'s very good at pretending.", "type": "choice" }, { "label": <null>, "speaker": <null>, "text": "Whether or not he was lying, Greenwich feels marginally more interesting than it did five minutes ago.", "type": "resolution" }], "deck": { "barometerState": <null>, "district": "greenwich", "excludeIfFlag": <null>, "weight": 1 }, "id": "busker_greenwich", "on_complete": [{ "op": "set_screen", "screen": "map" }] }, "buyer": { "cards": [{ "label": "The next morning", "speaker": <null>, "text": "Archie texts an address in Shoreditch and the word \"tonight\". You arrive to find him outside a craft beer bar, looking mildly disgusted by its existence.", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"Right. Same calc from the other night — I held onto it. Buyer\'s inside. Name\'s Marcus, finance, collects emotion-type for what he calls \'recreational use\'. Don\'t ask. Just be normal. Or close to it.\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"This is the same stuff. From when they tried to rob us.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Correct. Which is why having two of us is better than one. You\'re essentially a deterrent. Like a scarecrow. No offence.\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"Some offence.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Noted.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "Marcus is exactly what you expected: fleece, Patagonia, very clean trainers. He examines the calc with the careful enthusiasm of someone who has recently read about it online. He pays promptly, which is nice.", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"See? Smooth as you like. Most of them are like Marcus. Professional, prompt, no Stanley knife. That\'s the market we\'re targeting.\"", "type": "speaker" }, { "label": "Walking back — Shoreditch High Street", "speaker": <null>, "text": "Archie splits the cash on the pavement outside a Pret. The city moves around you, completely indifferent to any of this.", "type": "resolution" }, { "label": <null>, "speaker": "Archie", "text": "\"So. I\'ve got a contact who knows a lot more about this than I do. Bloke called James — craftsman, Bermondsey. Takes raw calc and makes things out of it. Like the pearls. I\'ve been meaning to introduce you.\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"Sure.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"I\'ll set it up. Give me a bell tomorrow.\"", "type": "speaker" }], "id": "buyer", "on_complete": [{ "op": "add", "path": "player.cash", "value": 40 }, { "flag": "buyerEventSeen", "op": "set_flag", "value": true }, { "op": "set_stage", "value": "sms_archie" }, { "contact": "archie", "from": "player", "op": "push_message", "text": "You mentioned a bloke called James. When can we sort that?" }, { "contact": "archie", "op": "push_message", "text": "Already arranged. Tomorrow — SE1 4YA, storage unit behind the Costcutter. Midday." }, { "contact": "archie", "kind": "james_meeting", "op": "queue_pending_message", "text": "Fair warning: James is the best craftsman I know and also the worst person I know. Don\'t take it personally. He\'s like that with everyone." }, { "op": "set_screen", "screen": "phone" }] }, "camden_shakedown": { "cards": [{ "label": "Camden", "speaker": <null>, "text": "Two lads corner you near the lock, doing their best impression of menace between a falafel stall and a man selling knock-off headphones. It\'s not entirely unconvincing.", "type": "narration" }, { "label": <null>, "speaker": "One of Them", "text": "\"Toll for using this bit of pavement. Fifty quid, and we all have a nice afternoon.\"", "type": "speaker" }, { "choices": [{ "effects": [{ "op": "add", "path": "player.cash", "value": -50 }], "label": "Pay £50", "result_text": "You pay. They seem almost disappointed not to have to do anything. You walk on with your dignity roughly 90% intact." }, { "effects": [{ "on_fail": [], "on_success": [{ "op": "start_street_mugging" }], "op": "chance", "p": 0.4 }], "label": "Refuse", "result_text": "You refuse. For a second, nobody moves - whatever happens next happens fast." }], "label": <null>, "speaker": <null>, "text": "The third one just stands there, which is somehow worse.", "type": "choice" }, { "label": <null>, "speaker": <null>, "text": "Camden closes back over you like nothing happened. Somewhere, a man is still selling headphones that don\'t work.", "type": "resolution" }], "deck": { "barometerState": <null>, "district": "camden", "excludeIfFlag": <null>, "weight": 1 }, "id": "camden_shakedown", "on_complete": [{ "op": "set_screen", "screen": "map" }] }, "city_suit": { "cards": [{ "label": "The City", "speaker": <null>, "text": "A man in a suit that costs more than your flat buys you a coffee you didn\'t order, in a café you\'d never choose. He introduces himself as \"a friend of a friend\", which in the City means nobody vouches for him.", "type": "narration" }, { "label": <null>, "speaker": "The Suit", "text": "\"I collect fate-type. Recreationally, you understand. Two hundred up front, I match it eightfold if the numbers land. If they don\'t — well. Markets.\"", "type": "speaker" }, { "choices": [{ "effects": [{ "op": "add", "path": "player.cash", "value": -200 }, { "on_fail": [], "on_success": [{ "op": "add_ore", "qty": 8, "type": "fate" }], "op": "chance", "p": 0.5 }], "label": "Trade (£200)", "result_text": "He taps his card against yours and doesn\'t blink. The transaction completes with the finality of all City transactions — you\'ll know how it went when you check your ore." }, { "effects": [], "label": "Pass", "result_text": "\"Suit yourself,\" he says, and you both know exactly which word he chose." }], "label": <null>, "speaker": <null>, "text": "He\'s already got his card reader out.", "type": "choice" }, { "label": <null>, "speaker": <null>, "text": "He\'s gone by the time you check your phone. Some men are only ever passing through.", "type": "resolution" }], "deck": { "barometerState": <null>, "district": "city", "excludeIfFlag": <null>, "weight": 1 }, "id": "city_suit", "on_complete": [{ "op": "set_screen", "screen": "map" }] }, "col_a1_archie_pry": { "cards": [{ "label": <null>, "speaker": <null>, "text": "You mention Des. Archie\'s face does the thing it does, which is nothing at all, quite deliberately.", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"He\'s good at ground. Best I know. Leave it there.\"", "type": "speaker" }, { "choices": [{ "effects": [], "label": "Leave it", "result_text": "You leave it. He looks briefly grateful and then annoyed with himself for looking grateful." }, { "effects": [{ "flag": "colA1AskedAboutDebt", "op": "set_flag", "value": true }, { "event": "col_a1_archie_pry_debt", "op": "start_event" }], "label": "Push", "result_text": "" }], "label": <null>, "speaker": <null>, "text": "He very obviously wants to leave it there.", "type": "choice" }], "id": "col_a1_archie_pry", "on_complete": [{ "op": "set_screen", "screen": "contacts" }] }, "col_a1_archie_pry_debt": { "cards": [{ "label": <null>, "speaker": "Archie", "text": "\"Four hundred and twenty quid. Fourteenth of March, 2019. I know because I wrote it in the book, because that\'s what you do.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"He\'s had six years and about nine conversations to say \'here\'s your money\' and instead I get - \" he does an impression that is unkind and quite accurate - \" \'we\'re all right, aren\'t we.\'\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "It is four hundred and twenty pounds. Archie has, in the time you\'ve known him, given away a vein.", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"Also, he\'s Crystal Palace. Obviously untrustworthy.\" He says it in the specific tone of a man producing a joke because the real answer has run out.", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "So that\'s what that is. A tenner\'s worth of grievance with six years of compound interest on it. You stop wondering about it, which is exactly what you were supposed to do.", "type": "resolution" }], "id": "col_a1_archie_pry_debt", "on_complete": [{ "op": "set_screen", "screen": "contacts" }] }, "col_a1_closer": { "cards": [{ "label": <null>, "speaker": <null>, "text": "All three of them are in the yard, which has never happened before and is not, apparently, an occasion. Nadia is sitting on an upturned crate. Des has his bag.", "type": "narration" }, { "label": <null>, "speaker": "Hakim", "text": "\"So there\'s a spot behind the flats on the other side of the estate. Been looking at it for about a year, wondering.\"", "type": "speaker" }, { "label": <null>, "speaker": "Hakim", "text": "\"It\'s life. Which is wrong for round here — round here is emotion, everyone knows that. But it\'s life, and it\'s good ground, and I don\'t know what to do with good ground.\"", "type": "speaker" }, { "label": <null>, "speaker": "Hakim", "text": "\"You\'re the one who\'s good at putting things in. So.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "Des has already got the jar out of his bag. He does not make a speech about it. He does not appear to have considered any other course of action.", "type": "narration" }, { "label": <null>, "speaker": "Des", "text": "\"Forty units, life. Had it about a month waiting for somewhere to put it.\"", "type": "speaker" }, { "choices": [{ "effects": [], "label": "Thank him", "result_text": "\"You\'re all right,\" he says, and means it, and the subject is closed." }, { "effects": [], "label": "Insist on paying", "result_text": "\"You can pay me back by doing this for somebody else in about a year.\" He hands you the jar. \"That\'s not me being nice, that\'s just how the accounting works round here.\"" }], "label": <null>, "speaker": <null>, "text": "You start to say something about paying him back.", "type": "choice" }, { "label": <null>, "speaker": <null>, "text": "It takes first time. The three of them watch you do it and then go straight back to talking about somebody\'s boiler.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "Later, walking back, you ask Des how you\'d actually join. Whether there\'s someone to ask.", "type": "narration" }, { "label": <null>, "speaker": "Des", "text": "\"There\'s no list. Nobody keeps one.\" He seems mildly amused you\'d think there was. \"You\'ve been doing this with us for a month. You\'re either one of us or you\'re not, and that\'s not really my call.\"", "type": "speaker" }, { "label": <null>, "speaker": "Nadia", "text": "\"He means yes.\"", "type": "speaker" }, { "choices": [{ "effects": [{ "faction": "collective", "op": "join_faction" }, { "flag": "colA1Joined", "op": "set_flag", "value": true }], "label": "I\'m in", "result_text": "\"Right,\" says Des, and that\'s the ceremony." }, { "effects": [{ "flag": "colA1DeferredJoin", "op": "set_flag", "value": true }], "label": "Not yet", "result_text": "\"Fair enough.\" He isn\'t offended. \"Offer doesn\'t expire. There\'s nothing to expire.\"" }], "label": <null>, "speaker": <null>, "text": "Behind you, Whitechapel does what it does.", "type": "choice" }, { "label": <null>, "speaker": <null>, "text": "You have a life vein in Whitechapel that a newsagent found and a prospector paid for, and no document anywhere records that any of this happened.", "type": "resolution" }], "id": "col_a1_closer", "on_complete": [{ "district": "whitechapel", "op": "scripted_seed", "oreType": "life", "tier": "rich" }, { "flag": "colA1Stage", "op": "set_flag", "value": "complete" }, { "flag": "colA1Complete", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a1_deferred_join": { "cards": [{ "label": <null>, "speaker": "Des", "text": "\"Right,\" he says, like you\'ve asked him what time it is. \"You\'re in. Don\'t need a form for it.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "That\'s it. That\'s the whole thing. Nobody hands you anything to prove it, and you walk out fractionally more a part of something than you were an hour ago.", "type": "resolution" }], "id": "col_a1_deferred_join", "on_complete": [{ "faction": "collective", "op": "join_faction" }, { "flag": "colA1Joined", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a1_des_report": { "cards": [{ "label": <null>, "speaker": <null>, "text": "You give Des the last address. He still doesn\'t write it down.", "type": "narration" }, { "label": <null>, "speaker": "Des", "text": "\"That\'s the pair, then.\" He\'s pleased in a way that takes a second to read as pleased. \"Two people who\'ll have something by the weekend.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"Archie all right? We go back — years, that. Had a bit of business once, sorted it out ages ago.\" He says it with the mild warmth of a man recalling a settled account, and moves on before you can ask which business.", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "You ask who. He tells you the first names and nothing else, and you realise a beat later that he has told you exactly as much as he\'d tell anyone about you.", "type": "narration" }, { "label": <null>, "speaker": "Des", "text": "\"Nobody\'s ever raided a vein they didn\'t know about.\" He says it as a small joke about paperwork. \"That\'s the whole trick. That\'s it. That\'s the entire clever bit.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "By the end of the week, both patches you found have veins in them and neither of them is yours. You are, apparently, fine with this, which is itself new information.", "type": "resolution" }], "id": "col_a1_des_report", "on_complete": [{ "flag": "colA1DesThreadDone", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a1_des_report_first_fate": { "cards": [{ "label": <null>, "speaker": <null>, "text": "You give Des one address. He doesn\'t write it down.", "type": "narration" }, { "label": <null>, "speaker": "Des", "text": "\"Fate. In the City, no less.\" He\'s pleased in a way that takes a second to read as pleased. \"That\'s one. Somebody\'ll have something by the weekend.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"Still want physics off you an\' all. No rush — just don\'t go thinking that\'s the job done.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "By the end of the week, one patch you found has a vein in it and it isn\'t yours. You seem fine with this.", "type": "resolution" }], "id": "col_a1_des_report_first_fate", "on_complete": [{ "op": "set_screen", "screen": "phone" }] }, "col_a1_des_report_first_physics": { "cards": [{ "label": <null>, "speaker": <null>, "text": "You give Des one address. He doesn\'t write it down.", "type": "narration" }, { "label": <null>, "speaker": "Des", "text": "\"Physics. Good — that\'s somebody sorted by the weekend.\" He\'s pleased in a way that takes a second to read as pleased.", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"Still want a fate patch off you an\' all. City, for preference — nobody round here\'s got the ground for it. No rush.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "By the end of the week, one patch you found has a vein in it and it isn\'t yours. You seem fine with this.", "type": "resolution" }], "id": "col_a1_des_report_first_physics", "on_complete": [{ "op": "set_screen", "screen": "phone" }] }, "col_a1_firm_intimidation": { "cards": [{ "label": <null>, "speaker": <null>, "text": "Three of them, waiting by your exit, in no particular hurry. The one in front has the patient look of somebody doing an errand.", "type": "narration" }, { "label": <null>, "speaker": "Firm Man", "text": "\"You\'ve been busy. Fate, physics — bit ambitious for someone who was doing a rent-a-vein in Whitechapel a month ago.\"", "type": "speaker" }, { "label": <null>, "speaker": "Firm Man", "text": "\"Nobody\'s asking you to stop. Just letting you know it\'s been noticed. There\'s a difference, and the difference is entirely up to you.\"", "type": "speaker" }, { "choices": [{ "effects": [{ "key": "firmFirstContact", "op": "log_method", "value": "backed_off" }], "label": "Back off", "result_text": "You take the long way round. Nothing happens, which is the point — somebody wanted a face and now has one." }, { "effects": [{ "key": "firmFirstContact", "op": "log_method", "value": "held" }], "label": "Hold your ground", "result_text": "You don\'t move and you don\'t say anything. He waits, decides it isn\'t worth the afternoon, and they go. He is slightly less pleasant on the way past." }, { "effects": [{ "key": "firmFirstContact", "op": "log_method", "value": "fought" }, { "op": "start_street_mugging" }], "label": "Tell them where to go", "result_text": "You tell him. There is a moment where it could still go either way, and then it doesn\'t." }], "label": <null>, "speaker": <null>, "text": "He hasn\'t threatened you. He\'s been very careful not to.", "type": "choice" }, { "label": <null>, "speaker": <null>, "text": "The patches are still yours to give away. That was never what this was about.", "type": "resolution" }], "id": "col_a1_firm_intimidation", "on_complete": [{ "flag": "colA1IntimidationSeen", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "map" }] }, "col_a1_firm_skirmish": { "cards": [{ "label": <null>, "speaker": <null>, "text": "You come round the corner into the end of something. Four people, one of them on the floor, and the specific quiet that happens after shouting rather than before it.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "Two of them are wearing the kind of coats that cost money. They are not hurrying. One is writing something down.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "By the time you\'ve decided whether to do anything, there are two people and one of them is being helped into a car by the other. Nobody looks at you. It has been arranged that there is nothing to look at.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "You ask Des about it later. He says \"Firm,\" the way you\'d say \"rain,\" and asks whether you found anything.", "type": "resolution" }], "id": "col_a1_firm_skirmish", "on_complete": [{ "flag": "colA1SkirmishSeen", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "map" }] }, "col_a1_hakim_done": { "cards": [{ "label": <null>, "speaker": <null>, "text": "The yard looks exactly the same. The vein does not. It reads as taking, and rising.", "type": "narration" }, { "label": <null>, "speaker": "Hakim", "text": "\"That\'s better than my uncle had it.\" He says this and then looks slightly stricken, as though he has been disloyal.", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "He pays you. It is not very much and he has clearly thought about the amount, and there is no version of refusing it that isn\'t worse.", "type": "narration" }, { "label": <null>, "speaker": "Hakim", "text": "\"Listen. I hear things. Not — I\'m not anybody, I just stand here and people talk. If I hear about ground going, round here, I\'ll text you. That\'s not me paying you back, that\'s just — I\'ll text you.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "You have made a newsagent\'s yard marginally more productive. Somewhere in the calculation of what you have spent your week on, this is either the least or the most important thing, and it won\'t be clear which for some time.", "type": "resolution" }], "id": "col_a1_hakim_done", "on_complete": [{ "faction": "collective", "op": "sell_contact_vein_to_faction", "price": 0, "veinIdStatePath": "collective.hakimVeinId" }, { "op": "add", "path": "player.cash", "value": 120 }, { "faction": "collective", "op": "faction_relation", "value": 10 }, { "flag": "colA1HakimThreadDone", "op": "set_flag", "value": true }, { "flag": "hakimIntelUnlocked", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a1_hakim_meet": { "cards": [{ "label": "Whitechapel Road", "speaker": <null>, "text": "The shop sells newspapers, phone credit, and a dozen kinds of crisps, among other things. There is a child\'s homework on the counter, half done, with a biro resting in the fold.", "type": "narration" }, { "label": <null>, "speaker": "Hakim", "text": "\"You\'re Des\'s. He said. Sorry - that came out like you\'re a dog.\"", "type": "speaker" }, { "label": <null>, "speaker": "Hakim", "text": "\"There\'s a vein in the yard. Came with the shop. My uncle had it and he was good with it and I\'m not, and it\'s been going backwards for about two years.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "The yard is eleven feet of concrete, three bins and a vein that has clearly not been touched in a long time. It reads as sparse and dropping.", "type": "narration" }, { "label": <null>, "speaker": "Hakim", "text": "\"It does about a third of what it used to. Which is about a third of the rent, so.\" He stops there, having got closer to complaining than he intended.", "type": "speaker" }, { "label": <null>, "speaker": "Hakim", "text": "\"Des says you\'re good at the growing part. I can\'t pay you properly. I can pay you something.\"", "type": "speaker" }, { "choices": [{ "effects": [], "label": "I\'ll do it", "result_text": "\"Right. Good. Thank you.\" He busies himself with the till so neither of you has to be looking at the other." }, { "effects": [], "label": "You don\'t have to pay me", "result_text": "\"I do, though.\" He says it flatly, and it is the only time he has been immovable about anything. \"I\'ll pay you something. I\'m not having it be a favour.\"" }], "label": <null>, "speaker": <null>, "text": "Behind him, through the doorway, somebody\'s homework is still half done.", "type": "choice" }, { "label": <null>, "speaker": <null>, "text": "You have taken on somebody\'s yard. It is not, in any measurable sense, a good use of your afternoons.", "type": "resolution" }], "id": "col_a1_hakim_meet", "on_complete": [{ "op": "grant_contact_vein", "statePath": "collective.hakimVeinId", "vein": { "alarmUpgrades": [], "district": "whitechapel", "growth": 18, "hospitability": { "bonuses": [], "tier": "fair" }, "location": "Whitechapel Road, the yard behind the newsagent\'s", "oreType": "emotion", "rampantDays": 0, "security": "none" } }, { "flag": "colA1HakimMet", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "map" }], "pin": { "contact": "hakim", "district": "whitechapel", "phoneLabel": "Go and meet Hakim", "showWhenFlagsFalse": ["colA1HakimMet"], "showWhenFlagsTrue": ["colA1HubReached"] } }, "col_a1_hub": { "cards": [{ "label": <null>, "speaker": <null>, "text": "Des has bought you a coffee you didn\'t ask for and won\'t let you pay for, which is becoming a pattern.", "type": "narration" }, { "label": <null>, "speaker": "Des", "text": "\"Right. You\'ve had a fortnight of me giving you things. That\'s fine, that\'s how it works, but it works both ways or it doesn\'t work.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"Three things. Take them in whatever order suits. Or don\'t — I\'m not your governor, nobody is.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"One\'s mine. We\'ve got people who can seed but haven\'t got ground. I need a fate patch and a physics patch, decent ones, and I need them left alone until I say. You find them, I\'ll do the rest.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"Two\'s Nadia. Hackney. She moves more calc in a week than the rest of us see in a month and she\'s short on something. Go and be useful to her; she\'ll tell you how.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"Three\'s Hakim. Newsagent, Whitechapel Road. He\'s got a vein in his yard that\'s on its way out and he hasn\'t got the hands for it. That one\'s not a favour to me, it\'s a favour to him, and he\'ll be embarrassed about it, so don\'t make it worse.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "He writes two phone numbers on the back of a receipt, which is the only record of any of this that will ever exist.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "Three names, three problems, no deadline and no order. The Collective, as far as you can tell, is a group of people who have each independently decided to be helpful and have never once discussed it.", "type": "resolution" }], "id": "col_a1_hub", "on_complete": [{ "contact": "nadia", "op": "unlock_contact" }, { "contact": "hakim", "op": "unlock_contact" }, { "flag": "colA1DesThreadActive", "op": "set_flag", "value": true }, { "flag": "colA1HubReached", "op": "set_flag", "value": true }, { "flag": "colA1Stage", "op": "set_flag", "value": "hub" }, { "flag": "colA1ArchiePryAvailable", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a1_intro": { "cards": [{ "label": "Shoreditch", "speaker": <null>, "text": "The lock-up smells of damp cardboard and, distantly, of something that isn\'t cardboard. Archie is standing outside it with the expression of a man who has already had this conversation in his head and did not enjoy it.", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"One vein. That\'s what you\'ve got. One vein, which I gave you, which I\'m now going to hear about for the rest of my life.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"One vein isn\'t a business, it\'s a hobby with rent. You want more, you have to go and find ground, and seed it, and I can\'t teach you that because I\'ve never done it. I shift stock. I don\'t dig.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "He fishes his keys out — a fat bunch, a Millennium Falcon keyring worn smooth at the edges — and lets you both into the lock-up.", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"So I called a bloke. He\'s good. He\'s the best I know at it, actually.\" A pause exactly long enough to be noticeable. \"He\'ll teach you. Then he\'ll go home.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "The man who comes in is in his forties, unhurried, with a canvas bag over one shoulder and the air of somebody who has never once been late but has often waited. He looks genuinely pleased to be here, which nobody else in this story has managed.", "type": "narration" }, { "label": <null>, "speaker": "Des", "text": "\"Desmond. Des. You\'re the one with the Whitechapel time vein.\" He says it like a fact he\'s glad about rather than one he\'s checking.", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Right. He knows ground, I know buyers, and between us you might make rent. That\'s the arrangement.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "Archie does not offer Des tea. Des does not appear to expect any. There is a silence with some history in it, and then Archie remembers somewhere else he needs to be.", "type": "narration" }, { "label": <null>, "speaker": "Des", "text": "\"He\'s all right, Archie. Bit of a transaction, but he\'s all right.\" He\'s already unpacking the bag. \"Right. Ground.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "You have a teacher. Neither of you has mentioned money, which is the first thing about today that will turn out to matter.", "type": "resolution" }], "id": "col_a1_intro", "on_complete": [{ "contact": "des", "op": "unlock_contact" }, { "flag": "colA1DesMet", "op": "set_flag", "value": true }, { "flag": "collectiveLaneUnlocked", "op": "set_flag", "value": true }, { "faction": "collective", "op": "faction_relation", "value": 5 }, { "flag": "colA1Stage", "op": "set_flag", "value": "tuition" }, { "op": "notify", "text": "Des reckons there\'s ground worth a look. Check the map." }, { "op": "set_screen", "screen": "contacts" }] }, "col_a1_nadia_done": { "cards": [{ "label": <null>, "speaker": "Nadia", "text": "\"Right. That\'s mine now.\" She counts out the money in a way that suggests she has counted out a great deal of money in her life. \"And that\'s three days a fortnight back.\"", "type": "speaker" }, { "label": <null>, "speaker": "Nadia", "text": "\"You\'ll get offers, by the way. People who want to buy ground off you cheap because you\'re new. Don\'t take them. Ask me first, I\'ll tell you what it\'s worth, and I\'ll tell you straight even when I\'m the one buying.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "You believe her, and you notice that you believe her, and you file that away.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "You have sold a vein. There\'s more money in your account than there was, and slightly less London that belongs to you. Feels like progress.", "type": "resolution" }], "id": "col_a1_nadia_done", "on_complete": [{ "faction": "collective", "op": "faction_relation", "value": 10 }, { "flag": "colA1NadiaThreadDone", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "vein_list" }] }, "col_a1_nadia_meet": { "cards": [{ "label": "Hackney — the back of a shop that sells phone cases", "speaker": <null>, "text": "Nadia Beckford is about seventy and is moving a crate that you would need help with. She does not accept help.", "type": "narration" }, { "label": <null>, "speaker": "Nadia", "text": "\"Des sent you. He\'s told you I\'m short.\" She doesn\'t look up. \"He\'s right. I\'m short.\"", "type": "speaker" }, { "label": <null>, "speaker": "Nadia", "text": "\"Standing order. Time calc, every fortnight, same bloke, same amount, been running four years. It pays for a lot of things that need paying for.\"", "type": "speaker" }, { "label": <null>, "speaker": "Nadia", "text": "\"This end of town\'s full of it and everyone round here has a bit and nobody has thirty units at once. So I spend three days on the phone every fortnight like it\'s 1974.\"", "type": "speaker" }, { "choices": [{ "effects": [], "label": "I can get you thirty", "result_text": "\"Course you can.\" She goes back to the crate. \"Bring it when you\'ve got it. Bring it in bits, I don\'t care.\"" }, { "effects": [], "label": "What\'s in it for me?", "result_text": "\"Market rate, same as anyone.\" A pause. \"You were expecting me to be offended. I\'m not. Ask people what things cost, it saves everybody a fortnight.\"" }], "label": <null>, "speaker": <null>, "text": "She finally looks up.", "type": "choice" }, { "label": <null>, "speaker": "Nadia", "text": "\"And before you ask — no, I don\'t know who\'s holding what. Nobody does. If I knew who had what I\'d have had this done Tuesday.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "Thirty units of time calc, no deadline, no paperwork, and a woman who has been doing this since before you were born treating it as entirely routine.", "type": "resolution" }], "id": "col_a1_nadia_meet", "on_complete": [{ "flag": "colA1NadiaMet", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a1_nadia_vein": { "cards": [{ "label": <null>, "speaker": "Nadia", "text": "\"That\'s the order filled and I\'m still doing three days on the phone every fortnight. That\'s not a solution, that\'s you being nice.\"", "type": "speaker" }, { "label": <null>, "speaker": "Nadia", "text": "\"So. Different idea. You seed me a time vein and I buy it off you. Then it\'s mine, it produces, and the standing order fills itself.\"", "type": "speaker" }, { "label": <null>, "speaker": "Nadia", "text": "\"You take the risk — the forty units, the seeding, whether it takes. I take a working vein and pay for it. That\'s not charity in either direction, that\'s just what things are worth.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "It is the first time anyone in the Collective has proposed a transaction to you where both halves were named out loud, and it\'s oddly restful.", "type": "narration" }, { "label": <null>, "speaker": "Nadia", "text": "\"Grow it a bit first if you\'ve any sense. I\'ll pay what it\'s worth on the day, and a hole in the ground with forty units in it isn\'t worth much yet.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "You now know that a vein is a thing that can be sold, which had genuinely not occurred to you.", "type": "resolution" }], "id": "col_a1_nadia_vein", "on_complete": [{ "flag": "veinSaleUnlocked", "op": "set_flag", "value": true }, { "flag": "colA1NadiaAskSeen", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a1_prospecting": { "cards": [{ "label": "Shoreditch — a service yard behind a coffee place", "speaker": <null>, "text": "Des has brought you to the least interesting place in Shoreditch and is looking at it with open enthusiasm.", "type": "narration" }, { "label": <null>, "speaker": "Des", "text": "\"Everyone looks for the dramatic bit. Cracked stone, old church, that sort of thing. Mostly what you want is somewhere that\'s been left alone a long time and had something happen to it once.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"Prospecting\'s a block of your day and a walk about. You\'ll turn up a patch or you won\'t. What you turn up depends on the ground round here and on how much of this you\'ve done before — that\'s it, that\'s the whole system.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"Patches come in grades. Poor, fair, rich, and once in a blue moon something that makes you sit down. Barren ones you leave; nothing takes in them.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"Different parts of London tend to skew more to a specific type. Round here it\'s whatever\'s going. Whitechapel\'s emotion, mostly. The City\'s fate, which probably isn\'t much of a surprise.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "He does not tell you which of these facts is the important one. You get the sense this is on purpose.", "type": "narration" }, { "label": <null>, "speaker": "Des", "text": "\"Go on. Have a look about. I\'ll be here.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "You spend the better part of an hour looking at brickwork with a seriousness that would embarrass you if anyone you knew walked past. Somewhere under all of it, London is doing what it does.", "type": "resolution" }], "id": "col_a1_prospecting", "on_complete": [{ "flag": "colA1ProspectingTaught", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "map" }], "pin": { "contact": "des", "district": "shoreditch", "phoneLabel": "Go prospecting with Des", "showWhenFlagsFalse": ["colA1ProspectingTaught"], "showWhenFlagsTrue": ["colA1DesMet"] } }, "col_a1_seeding": { "cards": [{ "label": <null>, "speaker": <null>, "text": "Des has a jar in his bag. In the jar is about forty units of somebody\'s physics calc, and he is holding it the way other people hold a thermos.", "type": "narration" }, { "label": <null>, "speaker": "Des", "text": "\"Finding a patch is half of it. A patch is just good ground. It doesn\'t do anything until you put something in it.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"Forty units of the right type. Has to match what the ground wants — you can\'t put fate in a life patch and hope. Costs you a block, and it doesn\'t always take. Better ground takes more often, and you get better at it.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"When it takes, you\'ve got a vein and the patch is yours. When it doesn\'t, you\'ve lost the calc and the afternoon, and you have another go when you can afford one.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "He says the last part without any particular weight, as a man describing weather.", "type": "narration" }, { "label": <null>, "speaker": "Des", "text": "\"Which is why nobody round here seeds alone if they don\'t have to. If I\'ve got forty spare and you\'ve found ground, that\'s not me lending you anything. That\'s the ground getting used.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"The needs of the many outweigh the needs of the few.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "He does not appear to think he has said anything unusual, and moves straight on to the practical bit about matching types, which he has now explained twice.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "You know how to seed a patch. You do not yet have forty units of anything spare, which is a different problem and, Des would say, a smaller one.", "type": "resolution" }], "id": "col_a1_seeding", "on_complete": [{ "flag": "colA1SeedingTaught", "op": "set_flag", "value": true }, { "contact": "des", "kind": "col_a1_hub", "op": "queue_pending_message", "text": "When you\'ve got a minute. Nothing urgent, but there are three things." }, { "op": "set_screen", "screen": "map" }], "pin": { "contact": "des", "district": "shoreditch", "phoneLabel": "Go seed a patch with Des", "showWhenFlagsFalse": ["colA1SeedingTaught"], "showWhenFlagsTrue": ["colA1ProspectingTaught"] } }, "col_a2_contested_vein": { "cards": [{ "label": "Camden", "speaker": <null>, "text": "A lock-up off the market that used to be Collective ground. Somebody\'s changed the padlock. Nobody saw it happen, or nobody\'s saying.", "type": "narration" }, { "label": <null>, "speaker": "Nadia", "text": "\"That one\'s the Firm\'s now. Since sometime after Hakim. Nobody rang to tell us — we just noticed the takings stopped.\"", "type": "speaker" }, { "choices": [{ "effects": [{ "op": "claim_faction_vein", "siteIdStatePath": "collective.contestedVeinSiteId" }, { "key": "a2ContestedVein", "op": "log_method", "value": "force" }], "label": "Take it back", "result_text": "You go in like it\'s still yours, because it still should be. Nobody\'s there to argue. That doesn\'t mean nobody notices." }, { "effects": [{ "faction": "firm", "op": "buy_faction_vein", "siteIdStatePath": "collective.contestedVeinSiteId" }, { "key": "a2ContestedVein", "op": "log_method", "value": "bought" }], "label": "Buy it back", "result_text": "\"You want it back, that\'s a price, same as anyone\'s. We\'re not precious about it. It was never really ours, was it — three weeks in a ledger doesn\'t make it family.\" He counts it without looking up. It is the least interesting thing that has happened to him all week." }], "label": <null>, "speaker": <null>, "text": "Two ways to have it back.", "type": "choice" }, { "label": <null>, "speaker": <null>, "text": "Either way, the lock-up is yours again. Whether it feels like it is a separate question, for later.", "type": "resolution" }], "id": "col_a2_contested_vein", "on_complete": [{ "flag": "colA2ContestedVeinDone", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "map" }], "pin": { "district": "camden", "showWhenFlagsFalse": ["colA2ContestedVeinDone"], "showWhenFlagsTrue": ["colA2Stage"] } }, "col_a2_handler_deferred": { "cards": [{ "label": <null>, "speaker": "Nadia", "text": "\"There\'s a way to know before it happens. Costs money. Costs the right kind of money, mind, not the kind we\'re short of.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"No.\" A pause, because he\'s noticed how that sounded. \"Not because it\'s wrong. Because it\'s too soon.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"You start with \'just this once\' and you don\'t notice the year it stopped being once.\"", "type": "speaker" }, { "label": <null>, "speaker": "Nadia", "text": "\"Fine. We do it the hard way first.\" She isn\'t fighting him on it, which is its own kind of answer.", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "Nobody writes it down, but it\'s agreed, the way things get agreed round here — once, out loud, and never mentioned again unless it stops holding.", "type": "resolution" }], "id": "col_a2_handler_deferred", "on_complete": [{ "flag": "colA2HandlerDeferred", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "phone" }] }, "col_a2_intro": { "cards": [{ "label": "Now", "speaker": <null>, "text": "Des writes full sentences. Punctuation, structure, the works. This wasn\'t that — four separate half-thoughts sent one after another, which is how you know something\'s wrong before you\'ve even read what it is.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "You don\'t reply. You\'re already moving.", "type": "narration" }], "id": "col_a2_intro", "on_complete": [{ "op": "set_screen", "screen": "contacts" }, { "event": "col_a2_shop", "op": "start_event" }] }, "col_a2_pattern": { "cards": [{ "label": <null>, "speaker": "Nadia", "text": "\"It\'s not just Hakim. Priya had someone on the phone about her window three days ago. Marcus actually got his window put through last week. Sef had a \'friendly visit\' from two blokes who complimented his stock.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"Temper doesn\'t organise itself into three separate visits inside a fortnight. Somebody decided we\'re worth the bother.\"", "type": "speaker" }, { "label": <null>, "speaker": "Des", "text": "\"Right. Something needs doing. I don\'t much care what order — pick at it as it comes.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "Nobody says the word plan. It isn\'t that, not yet. It\'s three problems and a room full of people who\'d rather be doing something than talking about it.", "type": "resolution" }], "id": "col_a2_pattern", "on_complete": [{ "flag": "colA2Stage", "op": "set_flag", "value": "call" }, { "op": "set_screen", "screen": "contacts" }, { "event": "col_a2_handler_deferred", "op": "start_event" }] }, "col_a2_shop": { "cards": [{ "label": "Whitechapel", "speaker": <null>, "text": "The shop\'s shutter is halfway down. The blind on the door is turned to closed.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "Hakim\'s on the stool behind the till, holding a tea towel full of ice from the freezer cabinet against his mouth. His lip\'s split. He keeps trying to talk properly around it.", "type": "narration" }, { "label": <null>, "speaker": "Hakim", "text": "\"I\'m fine,\" he says.", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "Des and Nadia are already there. Des isn\'t shouting. He\'s gone quiet instead, which nobody in the room has seen him do before. It makes everything feel even more serious.", "type": "narration" }, { "label": <null>, "speaker": "Des", "text": "\"Two of them. Made an offer for the shop and what\'s under it. A fair price, they said.\"", "type": "speaker" }, { "label": <null>, "speaker": "Hakim", "text": "\"I said no.\" He tries to shrug and thinks better of it halfway through. \"They didn\'t love that.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "Nobody involved has a name yet. From the way Nadia\'s talking, you think that will change soon - this attack won\'t go unanswered.", "type": "narration" }], "id": "col_a2_shop", "on_complete": [{ "flag": "colA2ShopSeen", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "contacts" }, { "event": "col_a2_pattern", "op": "start_event" }] }, "col_a2_vulnerable_site": { "cards": [{ "label": "Whitechapel", "speaker": <null>, "text": "A railway arch nobody\'s bothered to lock properly in three years. It\'s held ore the whole time and nothing\'s ever gone wrong with it - yet.", "type": "narration" }, { "label": <null>, "speaker": "Nadia", "text": "\"That one\'s ours and it\'s soft as anything. It was fine while nobody\'s looking twice at us. We\'re past that now.\"", "type": "speaker" }, { "choices": [{ "effects": [{ "op": "add", "path": "player.cash", "value": -150 }, { "op": "add", "path": "factions.collective.resources", "value": 150 }, { "key": "a2VulnerableSite", "op": "log_method", "value": "lookout" }], "label": "Fund a lookout (£150)", "result_text": "You put the money in, so someone doesn\'t need to pull a second shift and can spend it here, sitting on a crate near the arch most evenings, reading a paper without readlly reading it." }, { "effects": [{ "key": "a2VulnerableSite", "op": "log_method", "value": "soft" }], "label": "Stay soft and fast", "result_text": "You leave it as it is. Nobody\'s ever taken it before, and sometimes a lookout just draws more attention." }], "label": <null>, "speaker": <null>, "text": "Two ways to leave it.", "type": "choice" }, { "label": <null>, "speaker": <null>, "text": "Either way, the arch keeps doing what it\'s always done, for now. Whether that keeps being true is a separate question.", "type": "resolution" }], "id": "col_a2_vulnerable_site", "on_complete": [{ "flag": "colA2VulnerableSiteDone", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "map" }], "pin": { "district": "whitechapel", "showWhenFlagsFalse": ["colA2VulnerableSiteDone"], "showWhenFlagsTrue": ["colA2Stage"] } }, "col_hakim_intel": { "cards": [{ "label": <null>, "speaker": "Hakim", "text": "\"Bloke came in for a Lucozade and wouldn\'t shut up about the yard behind the launderette. Might be nothing. Thought you\'d want it before somebody else does.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "It is on your map now. He will not mention it again and will be embarrassed if you thank him twice.", "type": "resolution" }], "id": "col_hakim_intel", "on_complete": [{ "op": "reveal_site" }, { "op": "set_hakim_intel_day" }, { "op": "set_screen", "screen": "phone" }] }, "conclave_watch": { "cards": [{ "label": "The City", "speaker": <null>, "text": "A man in a good coat stands very still outside a bank that isn\'t a bank, watching nothing in particular with the specific attention of someone paid to watch nothing in particular. He doesn\'t look at you. That\'s how you know he\'s looked at you.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "By the time you think to look back properly, he\'s gone, and the space he was standing in has already been filled by three tourists and a Deliveroo rider, as if London itself hurried to paper over the gap.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "You add it to a growing list of things about the City you\'re choosing not to think about too hard.", "type": "resolution" }], "deck": { "barometerState": <null>, "district": "city", "excludeIfFlag": "conclaveNoticed", "weight": 1 }, "id": "conclave_watch", "on_complete": [{ "flag": "conclaveNoticed", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "map" }] }, "foxes": { "cards": [{ "label": <null>, "speaker": <null>, "text": "A fox crosses your path at the exact midpoint between two streetlights, pauses to look at you with total lack of interest, and continues on business you\'ll never be briefed on. London\'s real nightshift clocks on. You\'re not on the rota.", "type": "narration" }], "deck": { "barometerState": <null>, "district": "any", "excludeIfFlag": <null>, "weight": 1 }, "id": "foxes", "on_complete": [{ "op": "set_screen", "screen": "map" }] }, "heath_dogwalker": { "cards": [{ "label": "Hampstead Heath", "speaker": <null>, "text": "An older woman with four dogs and the bearing of a small aristocracy nods at you like you\'re expected. One of the dogs sniffs your bag with professional interest.", "type": "narration" }, { "label": <null>, "speaker": "Dogwalker", "text": "\"You\'re doing the ore thing, aren\'t you. Everyone up here can tell. Here - Wellington dug this up under an oak.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "She\'s gone before you can ask which dog is Wellington. All four look equally capable of digging up the past.", "type": "resolution" }], "deck": { "barometerState": <null>, "district": "hampstead", "excludeIfFlag": <null>, "weight": 1 }, "id": "heath_dogwalker", "on_complete": [{ "op": "add_ore", "qty": 2, "type": "life" }, { "op": "set_screen", "screen": "map" }] }, "home_raid_debrief_loss": { "cards": [{ "label": "Later", "speaker": <null>, "text": "You come round on the floor. Your ore is gone. The window is open. The rest of the place looks ransacked, though in hindsight it isn\'t too dissimilar to how it was before; you should probably tidy up a bit more often.", "type": "tension" }, { "label": <null>, "speaker": <null>, "text": "Archie arrives at seven in the morning. He takes one look at you and puts the coffees down without saying anything for a moment.", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"Right. How much did they get?\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"Most of it.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Yeah.\" He sits down. \"This place is a problem. I\'ve been meaning to say something for a while. One lock. Window doesn\'t close. It\'s practically a service entrance.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"You alright, though? Properly?\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"I\'m fine.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Good. Because here\'s the thing - you\'re still here, you still fought back, and that counts for something. I\'ve worked with people who\'d have just handed it over.\" He pauses. \"Some of them were me, early on.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"I think it\'s time we made this official. Partners. Properly. Which means I\'ve got a responsibility to make sure you\'re not operating out of a place someone can stroll into at three in the morning.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Got a bloke who does security - good stuff, fair price, no paperwork. And you need to start thinking about moving somewhere better. This is the kind of place that keeps happening to you until you leave it.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"And - the vein. Time vein, Whitechapel. I said I\'d give it to you and I meant it. It\'s barely tapped. Needs cultivating before it\'ll produce anything, but it\'s a start. Build it up, prune it, make pearls. I\'ll sort the buyers.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "He stays until you\'ve eaten something, which you didn\'t ask for and didn\'t expect. Then he leaves. You check your phone. There\'s a pin location. The vein.", "type": "resolution" }], "id": "home_raid_debrief_loss", "on_complete": [{ "flag": "homeRaidEventSeen", "op": "set_flag", "value": true }, { "flag": "homeRaidWon", "op": "set_flag", "value": false }, { "flag": "archiePartnerSeen", "op": "set_flag", "value": true }, { "flag": "homeUnlocked", "op": "set_flag", "value": true }, { "flag": "securityContactUnlocked", "op": "set_flag", "value": true }, { "contact": "archie", "op": "relation", "value": 10 }, { "op": "grant_vein_with_site", "vein": { "alarmUpgrades": [], "district": "whitechapel", "growth": 20, "hospitability": { "bonuses": [], "tier": "fair" }, "location": "Whitechapel, behind the old brewery", "oreType": "time", "rampantDays": 0, "security": "none" } }, { "op": "notify", "text": "HQ\'s workbench is open now." }, { "op": "set_screen", "screen": "phone" }] }, "home_raid_debrief_win": { "cards": [{ "label": "Forty minutes later", "speaker": <null>, "text": "The police were called by a neighbour and left without much interest. You gave a statement that was technically accurate in every detail that didn\'t matter. The raider is gone. Your ore is still here.", "type": "resolution" }, { "label": <null>, "speaker": <null>, "text": "Archie arrives at seven in the morning with two coffees and the air of a man who has absolutely expected this.", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"You alright?\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"Yeah. They didn\'t get anything.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Good. That\'s good.\" He looks around the flat. \"This place is a liability, you know that? One lock on the door and a window that doesn\'t close properly. You might as well put a sign up.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Anyway. You handled yourself, which is — honestly, that\'s more than I expected. No offence.\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"Some offence.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Fair. Look — this has made me think. We\'ve been doing well together. You\'ve been reliable, which in this line of work is genuinely rare. I think we should make it proper.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Official partners. Means I look out for you, you look out for me. And it means I can call in a favour — got a bloke who does security installs. Good gear, reasonable price, he doesn\'t ask questions. I\'ll have him round.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Also — and this is me being straight with you — you need to move. This place is done. Save up, find somewhere better. Nicer area, proper security, somewhere people can\'t just walk into at three in the morning.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"And — the vein. I said I\'d transfer it. Consider it done. Time vein, Whitechapel. It needs work before it\'ll produce anything, but it\'s yours. Cultivate it up, prune what you can, make pearls. I\'ll handle the buyers.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "He finishes his coffee and leaves before you can thank him, which is probably how he prefers it. You check your phone. There\'s a pin location. The vein.", "type": "resolution" }], "id": "home_raid_debrief_win", "on_complete": [{ "flag": "homeRaidEventSeen", "op": "set_flag", "value": true }, { "flag": "homeRaidWon", "op": "set_flag", "value": true }, { "flag": "archiePartnerSeen", "op": "set_flag", "value": true }, { "flag": "homeUnlocked", "op": "set_flag", "value": true }, { "flag": "securityContactUnlocked", "op": "set_flag", "value": true }, { "contact": "archie", "op": "relation", "value": 10 }, { "op": "grant_vein_with_site", "vein": { "alarmUpgrades": [], "district": "whitechapel", "growth": 20, "hospitability": { "bonuses": [], "tier": "fair" }, "location": "Whitechapel, behind the old brewery", "oreType": "time", "rampantDays": 0, "security": "none" } }, { "op": "notify", "text": "HQ\'s workbench is open now." }, { "op": "set_screen", "screen": "phone" }] }, "home_raid_intro": { "cards": [{ "label": "3:14 AM", "speaker": <null>, "text": "Something woke you up. You lie still for a moment, cataloguing the sounds of the building. The boiler. A fox outside. Then: footsteps, not from the corridor. From inside.", "type": "tension" }, { "label": <null>, "speaker": <null>, "text": "Your flatmates are out this whole week, but someone\'s in the flat. Moving carefully, which is almost worse than if they were crashing around - it means they\'ve done this before.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "You grab the nearest thing to hand - which, for better or worse, is the torch you left by the bed after last week when the power went out. After what feels like an eternity, your bedroom door slowly opens. You swing and feel the crack more than you hear it. THe intruder reels, then jumps at you.", "type": "tension" }], "id": "home_raid_intro", "on_complete": [{ "op": "start_home_raid_combat" }] }, "intro": { "cards": [{ "label": "Earlier tonight — Whitechapel", "speaker": <null>, "text": "Rent is due Friday. The job search has been exhausting and fruitless. You have forty quid left in your account. An old friend, Archie, said he might be able to help. So here you are, behind a chicken shop on Mile End Road at half ten on a Tuesday, while Archie holds a plastic Tesco bag with what looks like an opened Amazon box inside.", "type": "narration" }, { "image": "res://assets/events/intro/1.jpg", "label": <null>, "speaker": <null>, "text": "The buyers arrive in a grey Vauxhall. Three of them. That\'s one more than Archie mentioned. He notices too - you can tell by the way he stops whistling.", "type": "narration" }, { "image": "res://assets/events/intro/2.jpg", "label": "It goes wrong", "speaker": <null>, "text": "The one nearest to you produces a Stanley knife. His mate walks towards Arch and the bag. The third one just stands there, which is somehow worse. Archie says, very quietly: \"Yeah, okay.\"", "type": "tension" }, { "label": <null>, "speaker": "Archie", "text": "\"Alright chaps?\" he lifts the arm with the bag to wave, drawing everyone\'s eyes. You notice the other hand slip smoothly into his back pocket and pull something small out.", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "He doesn\'t even move his arm, just flicks his wrist in a practiced motion and whatever he was holding flies through the air. Only one of the thugs even clocks it, eyes tracing it as it lands harmlessly on the ground between him and his mates. It shatters. The air around the three men goes thick and syrupy. They slow. Not stop - but slow, like a video buffering. Archie wraps the Tesco bag handle around his hand and walks, briskly, to the exit of the alley.", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"Coming, or what?\"", "type": "speaker" }, { "image": "res://assets/events/intro/3.png", "label": "Fifteen minutes later — a Wetherspoons", "speaker": <null>, "text": "Archie orders two pints and a portion of chips. You sit down opposite him. Neither of you say anything until the chips arrive.", "type": "resolution" }, { "label": <null>, "speaker": "You", "text": "\"What the hell was that?\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Orichalchum. Time-type. Slows things down in a radius - maybe four, five seconds of real time bought, if you compress it right. Was my last one, actually, so cheers for that\". He raises his pint to the door, as though saluting the muggers.", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"Is that... magic?\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Nah\". He sips his pint, \"Well, almost. It\'s basically magic. Don\'t make a big deal out of it. It\'s just like any product-  some people source it, some people turn it into something useful, some people use it. In between all that, people like us can make a quid or two connecting them. If we\'re lucky.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Look. You need rent money. I need someone who isn\'t a liability. Come out with me tomorrow - I\'ve still got the calc from tonight, and I need to move it properly. I\'d feel better doing so with backup. You in?\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "You sigh, thinking about your bank balnace. \"Yeah.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Good. I\'ll text you in the morning. Don\'t do anything that ends you up in hospital before then.\"", "type": "speaker" }, { "image": "res://assets/events/intro/4.png", "label": <null>, "speaker": <null>, "text": "He finishes his pint and leaves. You sit with what\'s left of your pint, the chips, and the fact that your rent problem has somehow become a different problem entirely.", "type": "narration" }], "id": "intro", "on_complete": [{ "flag": "metArchie", "op": "set_flag", "value": true }, { "op": "set_stage", "value": "buyer_event" }, { "op": "set_screen", "screen": "phone" }] }, "james_meeting": { "cards": [{ "label": "Two days later — Bermondsey", "speaker": <null>, "text": "The address Archie texted is a storage unit beside a halal supermarket. You find him leaning against the corrugated shutter, hands in pockets, looking like he\'s waiting for a bus he knows is going to be late.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "The man who opens the shutter is in his sixties. Glasses with one slightly bent arm, a cardigan that has seen things. He looks at the two of you over the rim of his lenses with the specific expression of someone whose time is being wasted — and who has decided, provisionally, to allow it.", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"James. Cheers for this. This is — well, he\'s helping me out at the moment.\"", "type": "speaker" }, { "label": <null>, "speaker": "James", "text": "\"Yes. I can see that. Come in, then. Don\'t touch anything.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "Inside: shelves of labelled jars, a workbench covered in instruments that look like someone crossed a chemistry set with an antique shop. It smells of copper and something you can\'t name.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "You lean in toward a row of sealed jars. One of them contains something that shifts — not from the movement of the shelf, not from any air in the room. It moves, very slightly, as if it noticed you.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "You glance up. James is watching you. His expression doesn\'t change, exactly. But something in it does.", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"He\'s the best craftsman I know. Turns raw calc into — well, you\'ve seen what the pearls do.\"", "type": "speaker" }, { "label": <null>, "speaker": "James", "text": "\"Don\'t flatter me. I\'m the only craftsman you know. There\'s a difference.\" He turns to Archie. \"I have an order I need moved, but lack the time to do it. I\'ll give you the next batch of pearls - at cost - if you pick up a supply run for me. Stratford, in 45 minutes.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Yeah, alright. What am I picking up?\"", "type": "speaker" }, { "label": <null>, "speaker": "James", "text": "\"Physics calc, forty units. The address will be on your phone by the time you\'re at Stratford station.\" He sets down the jar he\'s holding. \"Your associate stays here.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"Right.\" He\'s already moving toward the door. \"Cheers, James. Back in a bit.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "The door closes. James stands in the silence for a moment, regarding you with the careful expression of a man who has decided to do something he hasn\'t fully justified to himself yet.", "type": "narration" }, { "label": <null>, "speaker": "James", "text": "\"I have a substantial order for time pearls. My usual assistant is indisposed. You\'ll do.\" A pause. \"I realise that isn\'t flattering. It isn\'t meant to be.\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"I don\'t know how to make them.\"", "type": "speaker" }, { "label": <null>, "speaker": "James", "text": "\"Evidently. That is why I am going to explain it to you, slowly, using small words. Even a reasonably attentive puppy could manage this. I\'m trusting you to clear that bar.\"", "type": "speaker" }, { "label": "Crafting: Time Pearl", "speaker": <null>, "text": "James walks you through it. Time orichalchum, compressed into a glass sphere under controlled conditions. The calc does most of the work - you\'re just the hands. The sphere seals itself when it\'s ready. Or it doesn\'t, and the calc disperses. That\'s it, really.", "type": "craft" }, { "label": <null>, "speaker": "James", "text": "\"The quality of the pearl depends on how cleanly you compress it. Rushed work means the time effect is weak and will last perhaps a few seconds. Patient, careful work produces something that can freeze a situation for longer. You will, at first, be rushing it. That\'s fine. You\'ll improve. Probably.\"", "type": "speaker" }, { "label": <null>, "speaker": "James", "text": "\"And do try your very best not to fuck it up. The calc isn\'t free.\"", "type": "speaker" }, { "label": <null>, "speaker": "James", "text": "\"You know, Plato described orichalchum as the second most precious metal in Atlantis. Wrote about it in the Critias  - considered it almost mystical in nature.\" He pauses. \"You have absolutely no idea what the Critias is, do you.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "It isn\'t really a question. You don\'t answer it.", "type": "narration" }, { "label": <null>, "speaker": "James", "text": "\"It doesn\'t matter. The point is that people have understood what this material is for approximately two and a half thousand years, and we still have people like Archie picking up deliveries outside a Poundland in Stratford. Make of that what you will.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "You spend two hours at the bench. Some of the pearls work. Some don\'t. James says nothing about the ones that don\'t, which is both surprising and a little unsettling.", "type": "resolution" }, { "label": <null>, "speaker": <null>, "text": "You leave with a crafting kit, a basic understanding of time pearl compression, and the distinct impression that James noticed something - and has decided, for now, not to mention it.", "type": "resolution" }], "id": "james_meeting", "on_complete": [{ "item": "timePearl", "op": "add_item", "qty": 2 }, { "flag": "metJames", "op": "set_flag", "value": true }, { "flag": "craftingUnlocked", "op": "set_flag", "value": true }, { "op": "add", "path": "contacts.james.unlocked", "value": true }, { "contact": "james", "op": "relation", "value": 10 }, { "op": "set_stage", "value": "archie_craft_chat" }, { "contact": "archie", "kind": "archie_craft_chat", "op": "queue_pending_message", "text": "Oi — how\'d it go with James? Come find me." }, { "op": "add", "path": "world.archieChatUnlockDay", "value": 1 }, { "op": "set_screen", "screen": "phone" }] }, "james_motion": { "cards": [{ "label": "Bermondsey — the storage unit", "speaker": <null>, "text": "James opens the door in what you\'re coming to recognise as his default expression: mild disappointment that the world continues to contain other people.", "type": "narration" }, { "label": <null>, "speaker": "James", "text": "\"You again.\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"I wanted to ask if you\'d be willing to teach me any other recipes. I\'ve been practising. I\'m better with the pearls now.\"", "type": "speaker" }, { "label": <null>, "speaker": "James", "text": "\"I\'m sure you are. Mediocrity tends to plateau early. What\'s in it for me?\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"If you\'ve got more orders than you can handle, I could take the overflow. Or just do the grunt work - the basic stuff that takes your time without needing your skill.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "James looks at you for a long moment. He picks up a glass sphere from his bench, turns it over, sets it down again. This appears to be how he thinks.", "type": "narration" }, { "label": <null>, "speaker": "James", "text": "\"You are proposing to be my assistant.\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"If that\'s how you want to frame it.\"", "type": "speaker" }, { "label": <null>, "speaker": "James", "text": "\"I want to frame it accurately. You would not be a partner, a student, or a colleague. You would handle simple orders. I would retain all complex work. You would not advertise yourself as my associate.\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"That\'s fine.\"", "type": "speaker" }, { "label": <null>, "speaker": "James", "text": "\"Hm.\" Another pause. \"Enhancement powder. It\'s straightforward. Life orichalchum, compressed differently to the pearls - outward rather than inward. Rub a small amount on the skin before physical exertion. Temporarily accelerates the user\'s movement.\"", "type": "speaker" }, { "label": "New recipe: Enhancement Powder", "speaker": <null>, "text": "The compression is different from pearls. You\'re squeezing the calc by pushing the vice handle until your hands hurt, then gently scraping it to collect the powder. The result is a fine iridescent dust. James demonstrates once. He expects you to manage after that.", "type": "craft" }, { "label": <null>, "speaker": "James", "text": "\"Quality scales with skill, as always. Low-grade powder gives you an edge over the average Joe. Better quality powder could make a couch potato compete with Usain Bolt. I trust you understand the principle.\"", "type": "speaker" }, { "label": <null>, "speaker": "James", "text": "\"I\'ll send you work when I have overflow. Don\'t expect it to be glamorous. And don\'t be late.\"", "type": "speaker" }, { "label": <null>, "speaker": <null>, "text": "You leave with the recipe and the firm sense that James considers this arrangement a concession rather than a collaboration. You suspect that won\'t change.", "type": "resolution" }], "id": "james_motion", "on_complete": [{ "flag": "jamesMotionEventSeen", "op": "set_flag", "value": true }, { "flag": "enhancementUnlocked", "op": "set_flag", "value": true }, { "contact": "james", "op": "relation", "value": 1 }, { "op": "set_screen", "screen": "contacts" }] }, "kx_delay": { "cards": [{ "label": "King\'s Cross", "speaker": <null>, "text": "The departures board changes its mind for the fourth time. Somewhere behind the barriers, a Tannoy voice apologises for something it clearly isn\'t sorry about.", "type": "narration" }, { "choices": [{ "effects": [{ "op": "lose_time_block" }], "label": "Wait it out", "result_text": "You wait. Time passes the way it only does in stations — all of it, somehow, at once." }, { "effects": [{ "op": "add", "path": "player.cash", "value": -30 }], "label": "Pay for a cab (£30)", "result_text": "You pay. The driver has opinions about the Northern line. You did not ask for them." }], "label": <null>, "speaker": <null>, "text": "Everyone\'s on the King\'s Cross deal. You are, for once, one of the delayed rather than the delighted.", "type": "choice" }, { "label": <null>, "speaker": <null>, "text": "Either way, you get where you\'re going. King\'s Cross remains, structurally, on its way somewhere else.", "type": "resolution" }], "deck": { "barometerState": <null>, "district": "kingscross", "excludeIfFlag": <null>, "weight": 1 }, "id": "kx_delay", "on_complete": [{ "op": "set_screen", "screen": "map" }] }, "pigeon_omen": { "cards": [{ "label": <null>, "speaker": <null>, "text": "A pigeon lands directly on your bag, considers you with the flat, ancient judgement pigeons reserve for people who look like they\'re up to something, and doesn\'t move.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "You\'ve heard the stories — fate-types collect near omens the way flies collect near anything else. You have no idea if this counts. The pigeon, notably, does not clarify.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "It flies off eventually, satisfied or bored, impossible to say which. You feel, absurdly, like your next piece of luck has already been decided somewhere above you.", "type": "resolution" }], "deck": { "barometerState": <null>, "district": "any", "excludeIfFlag": <null>, "weight": 1 }, "id": "pigeon_omen", "on_complete": [{ "flag": "luckyOmen", "op": "set_flag", "value": true }, { "op": "set_screen", "screen": "map" }] }, "rain": { "cards": [{ "label": <null>, "speaker": <null>, "text": "It starts raining the specific, personal way London rain does — not weather so much as a verdict. Nobody around you reacts; rain is not news here. You\'re soaked by the time you find shelter, mildly impressed at how quickly the city returns to pretending it didn\'t just do that.", "type": "narration" }], "deck": { "barometerState": <null>, "district": "any", "excludeIfFlag": <null>, "weight": 1 }, "id": "rain", "on_complete": [{ "op": "set_screen", "screen": "map" }] }, "rival_prospector": { "cards": [{ "label": <null>, "speaker": <null>, "text": "Someone else has clearly had the same idea about this patch of ground, and unlike you, they\'ve brought company.", "type": "narration" }, { "label": <null>, "speaker": "Rival", "text": "\"Friendly notice. We\'re taking an interest in the good plot round here. A hundred quid says our interest fades. Your call.\"", "type": "speaker" }, { "choices": [{ "effects": [{ "op": "add", "path": "player.cash", "value": -100 }], "label": "Pay them off (£100)", "result_text": "He pockets it without counting it, which is somehow more insulting than if he had. \"Pleasure doing business,\" he says, in the tone of a man who has never once meant that sentence." }, { "effects": [{ "op": "npc_claim_best_unclaimed_site" }], "label": "Let them have it", "result_text": "You shrug and walk off. By the time you\'re back, someone else\'s flag is already in the ground on the best plot going." }], "label": <null>, "speaker": <null>, "text": "He says \"friendly\" the way people say it right before it stops being true.", "type": "choice" }, { "label": <null>, "speaker": <null>, "text": "London rewards neither generosity nor spite. It just carries on.", "type": "resolution" }], "deck": { "barometerState": <null>, "district": "any", "excludeIfFlag": <null>, "requireUnclaimedSiteInDistrict": true, "weight": 1 }, "id": "rival_prospector", "on_complete": [{ "op": "set_screen", "screen": "map" }] }, "roman_brick": { "cards": [{ "label": <null>, "speaker": <null>, "text": "Half-buried in the churned ground of wherever you\'re standing is a brick — old, red, unmistakably Roman — in a spot with no plausible Roman history whatsoever.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "You\'ve seen one of these before. You didn\'t think anything of it then either. That\'s probably the point.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "You leave it where it is. Whatever\'s underneath London doesn\'t need your help finding daylight.", "type": "resolution" }], "deck": { "barometerState": <null>, "district": "any", "excludeIfFlag": <null>, "weight": 1 }, "id": "roman_brick", "on_complete": [{ "op": "add", "path": "flags.oddities", "value": 1 }, { "op": "set_screen", "screen": "map" }] }, "shoreditch_archie": { "cards": [{ "label": <null>, "speaker": <null>, "text": "Archie appears the way he always does - already mid-sentence, as though the conversation started before you arrived and you\'re just catching up.", "type": "narration" }, { "label": <null>, "speaker": "Archie", "text": "\"Hello hello. Fancy seeing you here. You look like someone currently doing something mildly reckless. Carry on. I\'m not your mum.\"", "type": "speaker" }, { "label": <null>, "speaker": "You", "text": "\"Comforting.\"", "type": "speaker" }, { "label": <null>, "speaker": "Archie", "text": "\"I do try.\" He nods once, like that\'s the whole conversation, and drifts back into whatever he was doing before he clocked you.", "type": "speaker" }], "deck": { "barometerState": <null>, "district": "any", "excludeIfFlag": <null>, "weight": 1 }, "id": "shoreditch_archie", "on_complete": [{ "contact": "archie", "op": "relation", "value": 2 }, { "op": "set_screen", "screen": "map" }] }, "soho_tout": { "cards": [{ "label": "Soho", "speaker": <null>, "text": "A man with a laminated card and the unkillable optimism of the professionally rejected steps into your path. \"Members\' bar, love — and word is there\'s a proper market coming to Soho too. Ore, gear, all sorts. Not yet, but soon. You\'ll want to be first.\" He\'s gone before you can ask what \"soon\" means in Soho years.", "type": "narration" }], "deck": { "barometerState": <null>, "district": "soho", "excludeIfFlag": <null>, "weight": 1 }, "id": "soho_tout", "on_complete": [{ "op": "set_screen", "screen": "map" }] }, "vein_raid": { "cards": [{ "label": "Night work", "speaker": <null>, "text": "Whoever\'s sitting on this vein hasn\'t put a name to it, but the ground still belongs to someone. You case the approach twice. No obvious watchers. That\'s not the same as no watchers.", "type": "tension" }, { "choices": [{ "effects": [{ "consumable_bonus": 0.05, "on_caught": [{ "flag": "raidCaught", "op": "set_flag", "value": true }, { "op": "notify", "text": "Something moves that shouldn\'t. You\'ve been seen." }, { "guards": 1, "op": "start_raid_combat", "template": "veinGuard" }], "on_success": [{ "flag": "raidCaught", "op": "set_flag", "value": false }, { "op": "notify", "text": "No alarms. You\'re in clean." }], "op": "stealth_check" }], "label": "Go slow", "result_text": "You take it slow — weight off every floorboard, timing the dark between passes." }, { "effects": [{ "consumable_bonus": -0.05, "on_caught": [{ "flag": "raidCaught", "op": "set_flag", "value": true }, { "op": "notify", "text": "Something moves that shouldn\'t. You\'ve been seen." }, { "guards": 1, "op": "start_raid_combat", "template": "veinGuard" }], "on_success": [{ "flag": "raidCaught", "op": "set_flag", "value": false }, { "op": "notify", "text": "No alarms. You\'re in clean." }], "op": "stealth_check" }], "label": "Go fast", "result_text": "You go in fast. Hesitation is what gets people caught, or so you tell yourself." }], "label": <null>, "speaker": <null>, "text": "One way in. You commit or you don\'t.", "type": "choice" }, { "choices": [{ "effects": [{ "op": "claim_raid_vein" }], "label": "Claim it", "result_text": "You take it outright. Word gets round fast — it always does — and the relationship with whoever ran this patch takes the hit that comes with being seen to do it." }, { "effects": [{ "op": "loot_raid_vein" }], "label": "Loot and leave", "result_text": "You take what you can carry and leave the rest where it stands. Someone else\'s problem, still." }], "label": <null>, "speaker": <null>, "text": "The vein\'s yours to deal with, however you got here.", "type": "choice" }], "id": "vein_raid", "on_complete": [{ "op": "set_screen", "screen": "map" }] }, "whitechapel_grief": { "cards": [{ "label": "Whitechapel", "speaker": <null>, "text": "Whitechapel keeps its grief the way other places keep street furniture — permanent, load-bearing, mostly ignored. You feel it anyway, a low hum under the emotion-type in your bag.", "type": "narration" }, { "label": <null>, "speaker": <null>, "text": "It passes, the way all inherited grief eventually does — not gone, just filed. The emotion-type in your bag sits heavier when you stand up, like it\'s been listening the whole time.", "type": "resolution" }], "deck": { "barometerState": <null>, "district": "whitechapel", "excludeIfFlag": <null>, "weight": 1 }, "id": "whitechapel_grief", "on_complete": [{ "op": "add_ore", "qty": 1, "type": "emotion" }, { "op": "set_screen", "screen": "map" }] } }. EVENTS should match the load manifest's snapshot fixture
