  "fillFromContext": true,
  "cards": [
    {
      "key": "intro",
      "type": "narration",
      "label": "Bermondsey - James's workshop",
      "speaker": null,
      "text": "Archie has pushed two benches together and set a Tesco meal deal at each place. Owen has been given a chair again."
    },
    {
      "key": "explain",
      "type": "speaker",
      "label": null,
      "speaker": "Archie",
      "text": "\"Board meeting. Every Monday, catering provided.\" He taps his sandwich. \"Three pitches, one goal each. You pick which one we chase this week.\""
    },
    {
      "key": "rules",
      "type": "speaker",
      "label": null,
      "speaker": "James",
      "text": "\"Next Monday I read the minutes and we find out whether you chose well. Choose anything. Nobody is wounded if it isn't theirs.\""
    },
    {
      "key": "next_week",
      "type": "speaker",
      "label": null,
      "speaker": "Archie",
      "text": "\"Worst you'll get is 'next week, then'. Then I pitch again, louder.\""
    },
    {
      "key": "owen",
      "type": "speaker",
      "label": null,
      "speaker": "Owen",
      "text": "\"Sorry. Do I have a vote?\""
    },
    {
      "key": "poach",
      "type": "speaker",
      "label": null,
      "speaker": "Archie",
      "text": "\"You're getting poached, Owen. Different department. Start Friday.\" James does not look up. \"He is not.\""
    },
