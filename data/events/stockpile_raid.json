{
  "id": "stockpile_raid",
  "observations": {
    "raid": {
      "mods": [],
      "blocks": {
        "physics": {
          "tiers": [
            { "base": 0.25, "text": "A loading hatch at the side, hinges rusted to paste. One shove and it's open." },
            { "base": 0.55, "text": "There's a service hatch at the back. It might give. It might not be quiet." }
          ],
          "miss": "Steel door, steel frame. Nothing here moves."
        },
        "life": {
          "tiers": [
            { "base": 0.25, "text": "The man on the door is half asleep. He props his head on one fist and loses the argument with it." },
            { "base": 0.55, "text": "The man on the door keeps yawning. He's been on too long." }
          ],
          "miss": "A figure behind the glass. You can't tell if he's awake."
        },
        "emotion": {
          "tiers": [
            { "base": 0.25, "text": "The guard is wound tight. He checks the same lock three times." },
            { "base": 0.55, "text": "The guard keeps glancing at the street, then at his phone, then at the street." }
          ],
          "miss": "Blank faces. They've done this before."
        },
        "time": {
          "tiers": [
            { "base": 0.25, "text": "A delivery van comes at the half hour and the door stands open for ninety seconds. Every time." },
            { "base": 0.55, "text": "Someone comes and goes at roughly the same times. Roughly." }
          ],
          "miss": "No pattern in the comings and goings that you can pin down."
        },
        "fate": {
          "tiers": [
            { "base": 0.25, "text": "You feel the moment the door guard looks away. A second before he does." },
            { "base": 0.55, "text": "Something is about to go wrong for someone here. Not necessarily you." }
          ],
          "miss": "No chances you can see. It's a door on a street."
        }
      }
    }
  },
  "cards": [
    { "key": "c1", "type": "tension", "label": "Their stores", "speaker": null, "observe": "raid", "text": "It took money to learn where they keep it. The door looks like every other door on the street, which is the point. Someone is paid to sit behind it." },
    {
      "key": "c2", "type": "choice", "label": null, "speaker": null, "text": "In and out before anyone counts.",
      "choices": [
        {
          "label": "Just go in",
          "check": { "base": 0.15, "raidFactors": true, "mods": [] },
          "success": {
            "result_text": "You walk in like you belong. Nobody asks.",
            "effects": [{ "op": "notify", "text": "No alarms. You're in clean." }],
            "goto": 4
          },
          "fail": {
            "result_text": "You walk in. Someone asks.",
            "effects": [
              { "op": "notify", "text": "The one on the door wasn't asleep. You've been seen." },
              { "op": "start_stockpile_raid_combat", "situational": [{ "if": { "observed": { "id": "raid", "ore": "physics", "atLeast": 1 } }, "fleeBoost": 0.25 }, { "if": { "observed": { "id": "raid", "ore": "life", "atLeast": 1 } }, "oneAtATime": true }, { "if": { "observed": { "id": "raid", "ore": "time", "atLeast": 1 } }, "sight": 2 }, { "if": { "observed": { "id": "raid", "ore": "fate", "atLeast": 1 } }, "firstStrike": true }] }
            ],
            "goto": 4
          }
        },
        {
          "label": "Go in loud",
          "effects": [
            { "op": "start_stockpile_raid_combat", "situational": [{ "if": { "observed": { "id": "raid", "ore": "physics", "atLeast": 1 } }, "fleeBoost": 0.25 }, { "if": { "observed": { "id": "raid", "ore": "life", "atLeast": 1 } }, "oneAtATime": true }, { "if": { "observed": { "id": "raid", "ore": "time", "atLeast": 1 } }, "sight": 2 }, { "if": { "observed": { "id": "raid", "ore": "fate", "atLeast": 1 } }, "firstStrike": true }] }
          ],
          "result_text": "No point creeping. You put your shoulder to the door and go in hard.",
          "goto": 4
        },
        {
          "label": "Weigh the quiet ways in",
          "reselectable": true,
          "effects": [],
          "result_text": null,
          "goto": 2
        }
      ]
    },
    {
      "key": "c3", "type": "choice", "label": null, "speaker": null, "text": "What you read, and what it buys you.",
      "choices": [
        {
          "label": "Take the hatch",
          "requires": { "observed": { "id": "raid", "ore": "physics", "atLeast": 1 } },
          "check": { "base": 0.6, "mods": [{ "observed": { "id": "raid", "ore": "physics", "atLeast": 2 }, "add": 0.15, "label": "A sharp read" }] },
          "success": {
            "result_text": "The hatch gives with a little flake of rust. You're in without a sound.",
            "effects": [{ "op": "notify", "text": "No alarms. You're in clean." }],
            "goto": 4
          },
          "fail": {
            "result_text": "The hatch sticks. Then it shrieks.",
            "effects": [
              { "op": "notify", "text": "The one on the door wasn't asleep. You've been seen." },
              { "op": "start_stockpile_raid_combat", "situational": [{ "if": { "observed": { "id": "raid", "ore": "physics", "atLeast": 1 } }, "fleeBoost": 0.25 }, { "if": { "observed": { "id": "raid", "ore": "life", "atLeast": 1 } }, "oneAtATime": true }, { "if": { "observed": { "id": "raid", "ore": "time", "atLeast": 1 } }, "sight": 2 }, { "if": { "observed": { "id": "raid", "ore": "fate", "atLeast": 1 } }, "firstStrike": true }] }
            ],
            "goto": 4
          }
        },
        {
          "label": "Wait out the sleepy guard",
          "requires": { "observed": { "id": "raid", "ore": "life", "atLeast": 1 } },
          "check": { "base": 0.6, "mods": [{ "observed": { "id": "raid", "ore": "life", "atLeast": 2 }, "add": 0.15, "label": "A sharp read" }] },
          "success": {
            "result_text": "His chin hits his chest. You step past before he finishes the thought.",
            "effects": [
              { "op": "reduce_raid_guards", "count": 1 },
              { "op": "start_stockpile_raid_combat", "situational": [{ "if": { "observed": { "id": "raid", "ore": "physics", "atLeast": 1 } }, "fleeBoost": 0.25 }, { "if": { "observed": { "id": "raid", "ore": "life", "atLeast": 1 } }, "oneAtATime": true }, { "if": { "observed": { "id": "raid", "ore": "time", "atLeast": 1 } }, "sight": 2 }, { "if": { "observed": { "id": "raid", "ore": "fate", "atLeast": 1 } }, "firstStrike": true }] }
            ],
            "goto": 4
          },
          "fail": {
            "result_text": "He shakes himself awake and looks up.",
            "effects": [
              { "op": "notify", "text": "The one on the door wasn't asleep. You've been seen." },
              { "op": "start_stockpile_raid_combat", "situational": [{ "if": { "observed": { "id": "raid", "ore": "physics", "atLeast": 1 } }, "fleeBoost": 0.25 }, { "if": { "observed": { "id": "raid", "ore": "life", "atLeast": 1 } }, "oneAtATime": true }, { "if": { "observed": { "id": "raid", "ore": "time", "atLeast": 1 } }, "sight": 2 }, { "if": { "observed": { "id": "raid", "ore": "fate", "atLeast": 1 } }, "firstStrike": true }] }
            ],
            "goto": 4
          }
        },
        {
          "label": "Rattle the guard",
          "requires": { "observed": { "id": "raid", "ore": "emotion", "atLeast": 1 } },
          "check": { "base": 0.6, "mods": [{ "observed": { "id": "raid", "ore": "emotion", "atLeast": 2 }, "add": 0.15, "label": "A sharp read" }] },
          "success": {
            "result_text": "You mention the lock sounds wrong. He goes to check it again.",
            "effects": [
              { "op": "reduce_raid_guards", "count": 1 },
              { "op": "start_stockpile_raid_combat", "situational": [{ "if": { "observed": { "id": "raid", "ore": "physics", "atLeast": 1 } }, "fleeBoost": 0.25 }, { "if": { "observed": { "id": "raid", "ore": "life", "atLeast": 1 } }, "oneAtATime": true }, { "if": { "observed": { "id": "raid", "ore": "time", "atLeast": 1 } }, "sight": 2 }, { "if": { "observed": { "id": "raid", "ore": "fate", "atLeast": 1 } }, "firstStrike": true }] }
            ],
            "goto": 4
          },
          "fail": {
            "result_text": "He doesn't scare. He does look at you.",
            "effects": [
              { "op": "notify", "text": "The one on the door wasn't asleep. You've been seen." },
              { "op": "start_stockpile_raid_combat", "situational": [{ "if": { "observed": { "id": "raid", "ore": "physics", "atLeast": 1 } }, "fleeBoost": 0.25 }, { "if": { "observed": { "id": "raid", "ore": "life", "atLeast": 1 } }, "oneAtATime": true }, { "if": { "observed": { "id": "raid", "ore": "time", "atLeast": 1 } }, "sight": 2 }, { "if": { "observed": { "id": "raid", "ore": "fate", "atLeast": 1 } }, "firstStrike": true }] }
            ],
            "goto": 4
          }
        },
        {
          "label": "Look further",
          "reselectable": true,
          "effects": [],
          "result_text": null,
          "goto": 3
        }
      ]
    },
    {
      "key": "c4", "type": "choice", "label": null, "speaker": null, "text": "More ways in, if you saw them.",
      "choices": [
