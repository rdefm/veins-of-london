          "check": { "base": 0.6, "mods": [{ "observed": { "id": "raid", "ore": "time", "atLeast": 2 }, "add": 0.15, "label": "A sharp read" }] },
          "success": {
            "result_text": "Ninety seconds, as advertised. You use eighty.",
            "effects": [{ "op": "notify", "text": "No alarms. You're in clean." }],
            "goto": 4
