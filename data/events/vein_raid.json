          "fail": {
            "result_text": "The word lands on the wrong ear. Nobody turns on anybody. They turn on you.",
            "effects": [
              { "op": "set_flag", "flag": "raidCaught", "value": true },
              { "op": "notify", "text": "Something moves that shouldn't. You've been seen." },
              { "op": "start_raid_combat", "preset": "veinGuards", "situational": [{ "if": { "cash": { "atLeast": 0 } }, "enemyFirstStrike": true }] }
            ],
            "goto": 4
