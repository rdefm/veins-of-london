{
  "_comment": "DailyBrief (systems/daily_brief.gd): BizBrief's Today card. tierOrder is the fixed row order; tierLabels the Today card's tier headings; rowCap the visible-row cap; doneMark prefixes a row ticked today; revealSeconds is the fade for newly ticked or expanded rows (none under reduced motion); demandPart is one good's piece of the demandSummary line (two or more demandSpike rows fold into it), demandExpand/CollapseLabel its toggle; rows maps each row template id to its tier, kind, label/consequence templates ({placeholders} filled by DailyBrief) and action button label. PROSE-REVIEW: every label, consequence, actionLabel, routinePart, demandPart, toggle label, more/less label and emptyState string here is new copy.",
  "rowCap": 6,
  "billWindowDays": 3,
  "veinRiskBands": ["barren", "sparse"],
  "veinCollapseNights": 2,
  "offerWindowDays": 1,
  "demandThreshold": 0.25,
  "tierOrder": ["urgent", "story", "opportunity", "routine"],
  "tierLabels": { "urgent": "Urgent", "story": "Story", "opportunity": "Opportunity", "routine": "Routine" },
  "emptyState": "Nothing pressing today.",
  "moreLabel": "+{n} more",
  "lessLabel": "Show less",
  "doneMark": "✓",
  "revealSeconds": 0.25,
  "routineExpandLabel": "Show",
  "routineCollapseLabel": "Hide",
  "demandExpandLabel": "Show",
  "demandCollapseLabel": "Hide",
  "demandPart": "{item} +{percent}%",
  "routineParts": {
    "veinAtRisk": "{n} sliding",
    "development": "{n} ready to develop",
    "idleStaff": "{n} staff idle",
    "oreShort": "{n} short of ore"
  },
  "storyActions": {
    "thread": { "actionLabel": "Read message" },
    "map": { "actionLabel": "Open map" },
    "rest": { "actionLabel": "Go to HQ" },
    "todo": { "actionLabel": "Open ToDo" }
  },
  "rows": {
    "story": {
      "tier": "story", "kind": "story",
      "label": "{text}",
      "consequence": "{note}",
      "actionLabel": "Open ToDo"
    },
    "depositGoal": {
      "tier": "story", "kind": "depositGoal",
      "label": "{text}",
      "consequence": "Saving for {name}.",
      "actionLabel": "Open Property"
    },
    "alarmHome": {
      "tier": "urgent", "kind": "alarm",
      "label": "Raid alarm · HQ",
      "consequence": "{deadline}. {consequence}",
      "actionLabel": "Respond"
    },
    "alarmVein": {
      "tier": "urgent", "kind": "alarm",
      "label": "Raid alarm · {title}",
      "consequence": "{deadline}. {consequence}",
      "actionLabel": "Respond"
    },
    "guardShortfall": {
      "tier": "urgent", "kind": "guardShortfall",
      "label": "Guard wages short",
      "consequence": "Unpaid guards walk on {deadline}: {places}.",
      "actionLabel": "Choose who stays"
    },
    "billRent": {
      "tier": "urgent", "kind": "bill",
      "label": "Rent due {weekday} · £{bill}",
      "consequence": "Short £{shortfall} for {weekday}. The gap goes on the arrears.",
      "actionLabel": "Pay rent"
    },
    "billUtilities": {
      "tier": "urgent", "kind": "bill",
      "label": "Bills due {weekday} · £{bill}",
      "consequence": "Short £{shortfall} for {weekday}. The gap goes on the arrears.",
      "actionLabel": "Pay bills"
    },
    "arrears": {
      "tier": "urgent", "kind": "arrears",
      "label": "Owed £{arrears} on the bills",
      "consequence": "{countdown}",
      "actionLabel": "Clear arrears"
    },
    "wagePrompt": {
      "tier": "urgent", "kind": "wages",
      "label": "{name} is owed £{owed}",
      "consequence": "Stopped working. The float needs £{topUp} to pay them.",
      "actionLabel": "Answer"
    },
    "wagesOwed": {
      "tier": "urgent", "kind": "wages",
      "label": "{name} is owed £{owed}",
      "consequence": "Stopped working until paid.",
      "actionLabel": "Pay"
    },
    "poach": {
      "tier": "urgent", "kind": "poach",
      "label": "{rival} offer {name} £{offer}/wk",
      "consequence": "You pay £{wage}. Match it or they leave on {deadline}.",
      "actionLabel": "Decide"
    },
    "contractAtRisk": {
      "tier": "urgent", "kind": "contractAtRisk",
      "label": "{buyer} order short by {shortfall}",
      "consequence": "Due {deadline}. Stock and production won't cover it; a short period pays less.",
      "actionLabel": "Check order"
    },
    "veinAtRiskUrgent": {
      "tier": "urgent", "kind": "veinAtRisk",
      "label": "{ore} vein, {district} · {band} ({growth})",
      "consequence": "Collapses in ~{nights} nights if left.",
      "actionLabel": "Cultivate"
    },
    "offerExpiring": {
      "tier": "opportunity", "kind": "offerExpiring",
      "label": "{buyer} offer · £{payment}",
      "consequence": "Expires {deadline}.",
      "actionLabel": "View offer"
    },
    "demandSpike": {
      "tier": "opportunity", "kind": "demandSpike",
      "label": "{item} demand up {percent}%",
      "consequence": "You hold {held}. Prices are up today.",
      "actionLabel": "Sell"
    },
    "demandSummary": {
      "tier": "opportunity", "kind": "demandSummary",
      "label": "{count} goods you hold in demand",
      "consequence": "{parts}",
      "actionLabel": "Show"
    },
    "favour": {
      "tier": "opportunity", "kind": "favour",
      "label": "{faction} want a favour",
      "consequence": "{name} is asking. Open until {deadline}.",
      "actionLabel": "Read message"
    },
    "veinAtRiskRoutine": {
      "tier": "routine", "kind": "veinAtRisk",
      "label": "{ore} vein, {district} · {band} ({growth})",
      "consequence": "Sliding. Collapse is ~{nights} nights off.",
      "actionLabel": "Cultivate"
    },
    "development": {
      "tier": "routine", "kind": "development",
      "label": "{ore} vein, {district} · ready to develop",
      "consequence": "Vein at {threshold}+. Chance to level up each day, and higher raid risk.",
      "actionLabel": "Tend vein"
    },
    "idleStaffNoRole": {
      "tier": "routine", "kind": "idleStaff",
      "label": "{name} is idle",
      "consequence": "No role, so no work.",
      "actionLabel": "Assign"
    },
    "idleStaffNoVeins": {
      "tier": "routine", "kind": "idleStaff",
      "label": "{name} is idle",
      "consequence": "No veins on their list.",
      "actionLabel": "Assign"
    },
    "oreShort": {
      "tier": "routine", "kind": "oreShort",
      "label": "{item} short of {ore}",
      "consequence": "Production stalls at {held} of {target}.",
      "actionLabel": "Fix production"
    },
    "routineSummary": {
      "tier": "routine", "kind": "routineSummary",
      "label": "{count} to look after",
      "consequence": "{parts}",
      "actionLabel": "Show"
    }
  }
}
