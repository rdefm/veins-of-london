{
  "_comment": "DailyBrief (systems/daily_brief.gd): BizBrief's Today card. tierOrder is the fixed row order; rowCap the visible-row cap; rows maps each row template id to its tier, kind, label/consequence templates ({placeholders} filled by DailyBrief) and action button label. PROSE-REVIEW: every label, consequence, actionLabel and emptyState string here is new copy.",
  "rowCap": 6,
  "billWindowDays": 3,
  "veinRiskBands": ["barren", "sparse"],
  "veinCollapseNights": 2,
  "tierOrder": ["urgent", "story", "opportunity", "routine"],
  "emptyState": "Nothing pressing today.",
  "storyActions": {
    "thread": { "actionLabel": "Messages" },
    "map": { "actionLabel": "Map" },
    "rest": { "actionLabel": "Rest" },
    "todo": { "actionLabel": "ToDo" }
  },
  "rows": {
    "story": {
      "tier": "story", "kind": "story",
      "label": "{text}",
      "consequence": "{note}",
      "actionLabel": "ToDo"
    },
    "alarmHome": {
      "tier": "urgent", "kind": "alarm",
      "label": "Raid alarm · HQ",
      "consequence": "{deadline}. {consequence}",
      "actionLabel": "Respond"
    },
    "alarmVein": {
      "tier": "urgent", "kind": "alarm",
      "label": "Raid alarm · {title}",
      "consequence": "{deadline}. {consequence}",
      "actionLabel": "Respond"
    },
    "guardShortfall": {
      "tier": "urgent", "kind": "guardShortfall",
      "label": "Guard wages short",
      "consequence": "Unpaid guards walk on {deadline}: {places}.",
      "actionLabel": "Choose who stays"
    },
    "billRent": {
      "tier": "urgent", "kind": "bill",
      "label": "Rent due {weekday} · £{bill}",
      "consequence": "Short £{shortfall} for {weekday}. The gap goes on the arrears.",
      "actionLabel": "Bank"
    },
    "billUtilities": {
      "tier": "urgent", "kind": "bill",
      "label": "Bills due {weekday} · £{bill}",
      "consequence": "Short £{shortfall} for {weekday}. The gap goes on the arrears.",
      "actionLabel": "Bank"
    },
    "arrears": {
      "tier": "urgent", "kind": "arrears",
      "label": "Owed £{arrears} on the bills",
      "consequence": "{countdown}",
      "actionLabel": "Property"
    },
    "wagePrompt": {
      "tier": "urgent", "kind": "wages",
      "label": "{name} is owed £{owed}",
      "consequence": "Stopped working. The float needs £{topUp} to pay them.",
      "actionLabel": "Answer"
    },
    "wagesOwed": {
      "tier": "urgent", "kind": "wages",
      "label": "{name} is owed £{owed}",
      "consequence": "Stopped working until paid.",
      "actionLabel": "Pay"
    },
    "contractAtRisk": {
      "tier": "urgent", "kind": "contractAtRisk",
      "label": "{buyer} order short by {shortfall}",
      "consequence": "Due {deadline}. Stock and production won't cover it; a short period pays less.",
      "actionLabel": "Sales"
    },
    "veinAtRiskUrgent": {
      "tier": "urgent", "kind": "veinAtRisk",
      "label": "{ore} vein, {district} · {band} ({growth})",
      "consequence": "Collapses in ~{nights} nights if left.",
      "actionLabel": "Cultivate"
    },
    "veinAtRiskRoutine": {
      "tier": "routine", "kind": "veinAtRisk",
      "label": "{ore} vein, {district} · {band} ({growth})",
      "consequence": "Sliding. Collapse is ~{nights} nights off.",
      "actionLabel": "Cultivate"
    },
    "development": {
      "tier": "routine", "kind": "development",
      "label": "{ore} vein, {district} · ready to develop",
      "consequence": "Raid exposure {exposure}.",
      "actionLabel": "Manage"
    }
  }
}
