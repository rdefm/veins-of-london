{
  "_comment": "DailyBrief (systems/daily_brief.gd): BizBrief's Today card. tierOrder is the fixed row order; rowCap the visible-row cap; rows maps each row template id to its tier, kind, label/consequence templates ({placeholders} filled by DailyBrief) and action button label. PROSE-REVIEW: every label, consequence, actionLabel, routinePart, more/less label and emptyState string here is new copy.",
  "rowCap": 6,
  "billWindowDays": 3,
  "veinRiskBands": ["barren", "sparse"],
  "veinCollapseNights": 2,
  "offerWindowDays": 1,
  "demandThreshold": 0.25,
  "tierOrder": ["urgent", "story", "opportunity", "routine"],
  "emptyState": "Nothing pressing today.",
  "moreLabel": "+{n} more",
  "lessLabel": "Show less",
  "routineExpandLabel": "Show",
  "routineCollapseLabel": "Hide",
  "routineParts": {
    "veinAtRisk": "{n} sliding",
    "development": "{n} ready to develop",
    "idleStaff": "{n} staff idle",
    "oreShort": "{n} short of ore"
  },
  "storyActions": {
    "thread": { "actionLabel": "Messages" },
    "map": { "actionLabel": "Map" },
    "rest": { "actionLabel": "Rest" },
    "todo": { "actionLabel": "ToDo" }
  },
  "rows": {
    "story": {
      "tier": "story", "kind": "story",
      "label": "{text}",
      "consequence": "{note}",
      "actionLabel": "ToDo"
    },
    "alarmHome": {
      "tier": "urgent", "kind": "alarm",
      "label": "Raid alarm · HQ",
      "consequence": "{deadline}. {consequence}",
      "actionLabel": "Respond"
    },
    "alarmVein": {
      "tier": "urgent", "kind": "alarm",
      "label": "Raid alarm · {title}",
      "consequence": "{deadline}. {consequence}",
      "actionLabel": "Respond"
    },
    "guardShortfall": {
      "tier": "urgent", "kind": "guardShortfall",
      "label": "Guard wages short",
      "consequence": "Unpaid guards walk on {deadline}: {places}.",
      "actionLabel": "Choose who stays"
    },
    "billRent": {
      "tier": "urgent", "kind": "bill",
      "label": "Rent due {weekday} · £{bill}",
      "consequence": "Short £{shortfall} for {weekday}. The gap goes on the arrears.",
      "actionLabel": "Bank"
    },
    "billUtilities": {
      "tier": "urgent", "kind": "bill",
      "label": "Bills due {weekday} · £{bill}",
      "consequence": "Short £{shortfall} for {weekday}. The gap goes on the arrears.",
      "actionLabel": "Bank"
    },
    "arrears": {
      "tier": "urgent", "kind": "arrears",
      "label": "Owed £{arrears} on the bills",
      "consequence": "{countdown}",
      "actionLabel": "Property"
    },
    "wagePrompt": {
      "tier": "urgent", "kind": "wages",
      "label": "{name} is owed £{owed}",
      "consequence": "Stopped working. The float needs £{topUp} to pay them.",
      "actionLabel": "Answer"
    },
    "wagesOwed": {
      "tier": "urgent", "kind": "wages",
      "label": "{name} is owed £{owed}",
      "consequence": "Stopped working until paid.",
      "actionLabel": "Pay"
    },
    "contractAtRisk": {
      "tier": "urgent", "kind": "contractAtRisk",
      "label": "{buyer} order short by {shortfall}",
      "consequence": "Due {deadline}. Stock and production won't cover it; a short period pays less.",
      "actionLabel": "Sales"
    },
    "veinAtRiskUrgent": {
      "tier": "urgent", "kind": "veinAtRisk",
      "label": "{ore} vein, {district} · {band} ({growth})",
      "consequence": "Collapses in ~{nights} nights if left.",
      "actionLabel": "Cultivate"
    },
    "offerExpiring": {
      "tier": "opportunity", "kind": "offerExpiring",
      "label": "{buyer} offer · £{payment}",
      "consequence": "Expires {deadline}. Accept it or it walks.",
      "actionLabel": "Offer"
    },
    "demandSpike": {
      "tier": "opportunity", "kind": "demandSpike",
      "label": "{item} demand up {percent}%",
      "consequence": "You hold {held}. London's paying for it today.",
      "actionLabel": "Sell"
    },
    "favour": {
      "tier": "opportunity", "kind": "favour",
      "label": "{faction} want a favour",
      "consequence": "{name} is asking. Open until {deadline}.",
      "actionLabel": "Messages"
    },
    "veinAtRiskRoutine": {
      "tier": "routine", "kind": "veinAtRisk",
      "label": "{ore} vein, {district} · {band} ({growth})",
      "consequence": "Sliding. Collapse is ~{nights} nights off.",
      "actionLabel": "Cultivate"
    },
    "development": {
      "tier": "routine", "kind": "development",
      "label": "{ore} vein, {district} · ready to develop",
      "consequence": "Raid exposure {exposure}.",
      "actionLabel": "Manage"
    },
    "idleStaffNoRole": {
      "tier": "routine", "kind": "idleStaff",
      "label": "{name} is idle",
      "consequence": "No role, so no work.",
      "actionLabel": "Staff"
    },
    "idleStaffNoVeins": {
      "tier": "routine", "kind": "idleStaff",
      "label": "{name} is idle",
      "consequence": "No veins on their list.",
      "actionLabel": "Staff"
    },
    "oreShort": {
      "tier": "routine", "kind": "oreShort",
      "label": "{item} short of {ore}",
      "consequence": "Production stalls at {held} of {target}.",
      "actionLabel": "Production"
    },
    "routineSummary": {
      "tier": "routine", "kind": "routineSummary",
      "label": "Routine · {count}",
      "consequence": "{parts}",
      "actionLabel": "Show"
    }
  }
}
