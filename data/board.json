  "templates": {
    "fin_reserve": {
      "label": "Build a cash reserve",
      "pitch": "Put weeks of running costs aside, so one bad week costs nothing.",
      "why": "The books show what a week costs now. The float should outlast it."
    },
    "share_first": {
      "label": "{ore} market share",
      "pitch": "Take a quarter of London's {ore}. Then we're a name, not a rumour.",
      "why": "James says {ore} is where the buyers are bunched. Pick your lane."
    },
    "share_higher": {
      "label": "Grow {ore} share",
      "pitch": "A quarter was the start. Push {ore} higher and the factions notice.",
      "why": "The window still shows room in {ore}."
    },
    "share_leader": {
      "label": "Lead the {ore} market",
      "pitch": "Not a share. The biggest share. Nobody sells more {ore} than us.",
      "why": "You're close enough to {ore} first place to smell it."
    },
    "share_second": {
      "label": "Second ore: {ore}",
      "pitch": "One ore is a niche. Take a slice of {ore} too.",
      "why": "{ore} is moving and nobody has it sewn up."
    },
    "cult_yield": {
      "label": "Lift the yield",
      "pitch": "If the veins gave a bit more than usual this week... only if that's all right.",
      "why": "Your last ten days give a baseline. A bit past it is the ask."
    },
    "cult_new_vein": {
      "label": "Bring a vein online",
      "pitch": "There's a new vein that could come good. I could watch it. If you'd like.",
      "why": "A fresh vein only counts once it's healthy enough to work."
    },
    "cult_health_streak": {
      "label": "Keep a vein healthy",
      "pitch": "A vein held in good condition night after night. Nobody's tried it properly.",
      "why": "The nightly count only runs while a vein stays in good shape."
    },
    "cult_second_ore": {
      "label": "A second ore",
      "pitch": "Not to alarm anyone, but we only have one kind of calc. Could we have two?",
      "why": "Two ore types in good health means the business isn't one bad week from empty."
    }
  },
