"COLLECTIVE_BARKS": {
"des": ["\"That'll go to someone who needs it. They won't know it was you.\"", "\"Good. That's someone's week easier.\"", "\"Weighed it twice. Habit, not distrust.\"", "\"Nobody's short this fortnight because of that. Worth doing.\"", "\"I'll not make a speech about it. Ta.\"", "\"Right. Onto the next thing that needs doing.\""],
"hakim": ["\"I'll put it under the counter with the other thing I'm not supposed to have under the counter.\"", "\"Ta. Sorry — you didn't need thanking, that's just what comes out.\"", "\"That'll do nicely. Don't tell my uncle I said 'nicely'.\"", "\"Right, that's counted. Mind how you go.\"", "\"Someone'll be glad of that. Not saying who.\"", "\"Cheers. Shop's not going to run itself, so.\""],
"nadia": ["\"Counted. Correct. Go on then.\"", "\"Fair price. Don't let anyone tell you otherwise.\"", "\"That's one less phone call I have to make.\"", "\"Noted. Next.\"", "\"You're getting the hang of this.\"", "\"Good. Now go and do something useful.\""]
},
"COMBAT_ATTACK_BONUS_BY_LEVEL": [0, 0, 2, 4, 7, 11],
"COMBAT_PROTOTYPE": {
"_comment": "day-rhythm-business-and-combat ticket 14: bounded solo combat prototype (rules per ticket 13a) -- prototype-only, NOT production balance, not cross-referenced by REFERENCE.md. encounterOrder is the fixed brawler -> knifeFighter -> enforcer teaching sequence; those three entries keep ticket 14's original flat single-enemy shape (name/hp/attackMin/attackMax/speed/evadeChance/script at the encounter's own top level) for backward compatibility -- CombatPrototype._current_wave_defs() wraps a flat entry as a one-element roster. Ticket 15 (squad/progression prototype) adds three more encounters, reached outside encounterOrder (via CombatPrototype.list_launchable_encounters(), surfaced as extra Debug-app cards): 'pairAmbush' (two enemies, both scripted at the player every round -- demonstrates that a stance committed against one attacker leaves the other fully dangerous, ticket 15 checklist item 1), 'mixedCrew' (three enemies, one of each teaching archetype together -- the squad-tactics evaluation roster, checklist item 2), and 'gauntlet' (two waves fought back-to-back with no HP reset between them -- the sustained-power/readability check, checklist item 5). A squad entry's roster lives under 'enemies' (array of the same per-enemy fields the flat encounters use); a multi-wave entry's rosters live under 'waves' (array of 'enemies'-shaped arrays, fought in order). `script` is each enemy's deterministic committed-action cycle, always aimed at the player -- CombatPrototype only advances an enemy's own scriptIndex on a round it actually commits (a frozen or exhausted skip round doesn't consume a step). PROSE-REVIEW: every `name`/`intro`/`teaches` string here is new copy, drafted against CONTENT-GUIDE.md's tone bible.",
"encounterOrder": ["brawler", "knifeFighter", "enforcer"],
"encounters": {
"brawler": {
"attackMax": 12,
"attackMin": 6,
"evadeChance": 0,
"hp": 30,
"intro": "He squares up, all shoulders. Nothing subtle about what's coming.",
"name": "The Brawler",
"script": ["heavy"],
"speed": 8,
"teaches": "Heavy, Dodge, exhaustion"
},
"enforcer": {
"attackMax": 13,
"attackMin": 6,
"evadeChance": 0,
"hp": 42,
"intro": "He's done this before -- watching for an opening, not just swinging.",
"name": "The Enforcer",
"script": ["counter", "heavy"],
"speed": 10,
"teaches": "Counter, Heavy"
},
"gauntlet": {
"intro": "First lot's just the warm-up. There's more waiting behind them.",
"name": "The Gauntlet",
"teaches": "sustained power across waves -- no reset between fights",
"waves": [[{
"attackMax": 9,
"attackMin": 4,
"evadeChance": 0,
"hp": 20,
"name": "Gauntlet Runner",
"script": ["fast"],
"speed": 9
}, {
"attackMax": 9,
"attackMin": 4,
"evadeChance": 0,
"hp": 20,
"name": "Gauntlet Runner",
"script": ["heavy"],
"speed": 6
}], [{
"attackMax": 13,
"attackMin": 6,
"evadeChance": 0,
"hp": 42,
"name": "Gauntlet Enforcer",
"script": ["counter", "heavy"],
"speed": 10
}]]
},
"knifeFighter": {
"attackMax": 10,
"attackMin": 5,
"evadeChance": 0,
"hp": 26,
"intro": "Quick on her feet, blade held low. She won't telegraph much.",
"name": "The Knife Fighter",
"script": ["fast"],
"speed": 13,
"teaches": "Fast, Counter"
},
"mixedCrew": {
"enemies": [{
"attackMax": 12,
"attackMin": 6,
"evadeChance": 0,
"hp": 30,
"name": "The Brawler",
"script": ["heavy"],
"speed": 8
}, {
"attackMax": 10,
"attackMin": 5,
"evadeChance": 0,
"hp": 26,
"name": "The Knife Fighter",
"script": ["fast"],
"speed": 13
}, {
"attackMax": 13,
"attackMin": 6,
"evadeChance": 0,
"hp": 42,
"name": "The Enforcer",
"script": ["counter", "heavy"],
"speed": 10
}],
"intro": "A brawler, a blade, and someone who's clearly run this before. Three at once.",
"name": "Mixed Crew",
"teaches": "squad tactics -- does one strategy dominate a mixed line-up?"
},
"pairAmbush": {
"enemies": [{
"attackMax": 10,
"attackMin": 5,
"evadeChance": 0,
"hp": 24,
"name": "First Tough",
"script": ["fast"],
"speed": 9
}, {
"attackMax": 10,
"attackMin": 5,
"evadeChance": 0,
"hp": 24,
"name": "Second Tough",
"script": ["fast"],
"speed": 7
}],
"intro": "Two of them, spread wide. Whoever you watch, the other one's free.",
"name": "Pair Ambush",
"teaches": "single-target defence leaves other threats live"
}
}
},
